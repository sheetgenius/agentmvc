+++ b/tests/integer_query_predicates.rb
@@ -0,0 +1,39 @@
+require_relative '../runtime/ruby/active_record/base'
+require_relative '../runtime/ruby/active_record/relation'
+class IntegerProbe < ActiveRecord::Base
+  def self.table_name; 'probes'; end
+  def self.primary_key; 'id'; end
+  def self.schema_integer_limits
+    { 'id' => 8, 'owner_id' => 8, 'number' => 4, 'probes.owner_id' => 8 }
+  end
+end
+
+def equal(expected, actual)
+  raise "expected #{expected.inspect}, got #{actual.inspect}" unless expected == actual
+end
+[4, 8].each do |width|
+  max = 2**(width * 8 - 1) - 1
+  min = -max - 1
+  [max, min, 0, 1].each { |n| equal(n.to_s, ActiveRecord.integer_query_value(n.to_s, width)) }
+  [max + 1, min - 1, 10**80, -(10**80)].each { |n| equal('', ActiveRecord.integer_query_value(n.to_s, width)) }
+  ['', 'junk', '+junk', '  -x'].each { |n| equal('NULL', ActiveRecord.integer_query_value(n, width)) }
+  { '  +1tail' => '1', '0junk' => '0', '-0000' => '0', '1_0' => '10', '1__0' => '1', '1.9' => '1', '+0001' => '1' }.each do |s, value|
+    equal(value, ActiveRecord.integer_query_value(s, width))
+  end
+end
+r = ActiveRecord::Relation.new(IntegerProbe)
+[:id, :owner_id, :number].each do |col|
+  equal('1=0', r.column_predicate(col.to_s, 10**80))
+  equal('1=0', r.column_predicate(col.to_s, -(10**80)))
+  equal("probes.#{col} = NULL", r.column_predicate(col.to_s, 'junk'))
+  equal("probes.#{col} = 1", r.column_predicate(col.to_s, ' +1tail'))
+  equal("probes.#{col} IS NULL", r.column_predicate(col.to_s, nil))
+  equal("probes.#{col} = 1", r.column_predicate(col.to_s, true))
+  equal("probes.#{col} = 0", r.column_predicate(col.to_s, false))
+  equal("probes.#{col} = 1", r.column_predicate(col.to_s, 1.9))
+end
+equal('1=0', r.column_predicate('number', 2147483648))
+equal('probes.owner_id = 2147483648', r.column_predicate('probes.owner_id', 2147483648))
+equal('(probes.owner_id IN (NULL, 1) OR probes.owner_id IS NULL)', r.column_predicate('owner_id', [nil, 'junk', '1', 10**80]))
+equal('1=0', r.column_predicate('id', [10**80]))
+puts 'integer query serialization: passed'
