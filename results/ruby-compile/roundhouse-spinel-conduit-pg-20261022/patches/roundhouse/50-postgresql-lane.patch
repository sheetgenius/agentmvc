diff --git a/runtime/spinel/db_libpq.rb b/runtime/spinel/db_libpq.rb
new file mode 100644
--- /dev/null
+++ b/runtime/spinel/db_libpq.rb
@@ -0,0 +1,794 @@
+# frozen_string_literal: true
+
+# PostgreSQL implementation of Roundhouse's module Db contract.
+# Compile with Spinel 813def1f; links libpq directly. DATABASE_URL is conninfo.
+# Text wire format: arrays/jsonb/uuid stay strings; bool and numeric OIDs decode.
+# The only carried C helpers own a const char** parameter vector; they copy
+# strings because the Spinel FFI guarantees Ruby string lifetime for one call.
+require "json"
+require_relative "active_support_time_parsing"
+
+module PG
+  ffi_lib "pq"
+  ffi_const :CONNECTION_OK, 0
+  ffi_const :COMMAND_OK, 1
+  ffi_const :TUPLES_OK, 2
+  ffi_const :SQLSTATE, 67 # PG_DIAG_SQLSTATE = 'C'
+  ffi_func :PQconnectdb, [:str], :ptr, blocking: true
+  ffi_func :PQstatus, [:ptr], :int
+  ffi_func :PQerrorMessage, [:ptr], :str
+  ffi_func :PQfinish, [:ptr], :void
+  ffi_func :PQexec, [:ptr, :str], :ptr, blocking: true
+  ffi_func :PQprepare, [:ptr, :str, :str, :int, :ptr], :ptr, blocking: true
+  ffi_func :PQdescribePrepared, [:ptr, :str], :ptr, blocking: true
+  ffi_func :PQexecPrepared, [:ptr, :str, :int, :ptr, :ptr, :ptr, :int], :ptr, blocking: true
+  ffi_func :PQresultStatus, [:ptr], :int
+  ffi_func :PQresultErrorMessage, [:ptr], :str
+  ffi_func :PQresultErrorField, [:ptr, :int], :str
+  ffi_func :PQclear, [:ptr], :void
+  ffi_func :PQntuples, [:ptr], :int
+  ffi_func :PQnfields, [:ptr], :int
+  ffi_func :PQnparams, [:ptr], :int
+  ffi_func :PQfname, [:ptr, :int], :str
+  ffi_func :PQftype, [:ptr, :int], :uint32
+  ffi_func :PQgetisnull, [:ptr, :int, :int], :int
+  ffi_func :PQgetvalue, [:ptr, :int, :int], :str
+  ffi_func :PQcmdTuples, [:ptr], :str
+  ffi_func :PQtransactionStatus, [:ptr], :int
+  ffi_func :PQescapeLiteral, [:ptr, :str, :size_t], :ptr
+  ffi_func :PQfreemem, [:ptr], :void
+  ffi_source <<~C
+    #include <stdlib.h>
+    #include <string.h>
+    const char *rh_pg_string(void *p) { return (const char *)p; }
+    void *rh_pg_params_new(int n) { return calloc(n ? n : 1, sizeof(char *)); }
+    int rh_pg_params_set(void *p, int n, int i, const char *s) {
+      if (i < 1 || i > n) return -1;
+      char **v = (char **)p;
+      char *copy = s ? strdup(s) : NULL;
+      if (s && !copy) return -2;
+      free(v[i-1]); v[i-1] = copy; return 0;
+    }
+    void rh_pg_params_free(void *p, int n) {
+      if (!p) return;
+      char **v = (char **)p;
+      for (int i=0; i<n; i++) free(v[i]);
+      free(v);
+    }
+  C
+  ffi_func :rh_pg_string, [:ptr], :str
+  ffi_func :rh_pg_params_new, [:int], :ptr
+  ffi_func :rh_pg_params_set, [:ptr, :int, :int, :str], :int
+  ffi_func :rh_pg_params_free, [:ptr, :int], :void
+end
+
+class DbConn
+  def initialize(conninfo)
+    @dbh = PG.PQconnectdb(conninfo)
+    raise "PQconnectdb: allocation failed" if @dbh.nil?
+    if PG.PQstatus(@dbh) != PG::CONNECTION_OK
+      # Avoid including conninfo/password in errors.
+      message = PG.PQerrorMessage(@dbh)
+      PG.PQfinish(@dbh)
+      raise "PQconnectdb: " + message
+    end
+    @serial = 0
+    @changes = 0
+    @sqlstate = ""
+    r = PG.PQexec(@dbh, "SET standard_conforming_strings = on; SET timezone = 'UTC'; SET datestyle = 'ISO, YMD'; SET client_min_messages = warning")
+    Db.check_result(self, r)
+    PG.PQclear(r)
+  end
+  def dbh
+    @dbh
+  end
+  def next_name
+    @serial += 1
+    "rh_pg_" + @serial.to_s
+  end
+  def changes
+    @changes
+  end
+  def set_changes(n)
+    @changes = n
+  end
+  def sqlstate
+    @sqlstate
+  end
+  def set_sqlstate(s)
+    @sqlstate = s
+  end
+  def close
+    PG.PQfinish(@dbh)
+  end
+end
+
+# Owns both server prepared statement and PGresult cursor. Result metadata is
+# available immediately from PQdescribePrepared, before bind/step (select_rows
+# relies on this). Unlike SQLite, PGresult materializes all rows at first step.
+class PgStmt
+  def initialize(conn, name, description)
+    @conn = conn
+    @name = name
+    @result = description
+    @nparams = PG.PQnparams(description)
+    @params = PG.rh_pg_params_new(@nparams)
+    raise "parameter allocation failed" if @params.nil?
+    @row = -1
+    @executed = false
+    @closed = false
+  end
+  def conn
+    @conn
+  end
+  def result
+    @result
+  end
+  def row
+    @row
+  end
+  def bind(idx, text)
+    raise "bind after execution/finalize" if @executed || @closed
+    rc = PG.rh_pg_params_set(@params, @nparams, idx, text)
+    raise "invalid parameter index/allocation" if rc != 0
+    nil
+  end
+  def advance
+    raise "step after finalize" if @closed
+    if !@executed
+      r = PG.PQexecPrepared(@conn.dbh, @name, @nparams, @params, nil, nil, 0)
+      Db.check_result(@conn, r)
+      PG.PQclear(@result)
+      @result = r
+      @executed = true
+      @conn.set_changes(PG.PQcmdTuples(r).to_i)
+    end
+    @row += 1
+    @row < PG.PQntuples(@result)
+  end
+  def close
+    return nil if @closed
+    PG.PQclear(@result)
+    PG.rh_pg_params_free(@params, @nparams)
+    # DEALLOCATE errors during an aborted transaction must not mask the
+    # original error; rollback on lease release will recover the connection.
+    r = PG.PQexec(@conn.dbh, "DEALLOCATE " + @name)
+    PG.PQclear(r) if !r.nil?
+    @closed = true
+    nil
+  end
+end
+
+class DbPool
+  def initialize(conninfo, n)
+    @conns = []
+    @free = []
+    @lock = Mutex.new
+    @cv = ConditionVariable.new
+    i = 0
+    while i < n
+      @conns.push(DbConn.new(conninfo))
+      @free.push(i)
+      i += 1
+    end
+  end
+  def lease
+    idx = 0
+    @lock.synchronize do
+      @cv.wait(@lock) while @free.empty?
+      idx = @free.delete_at(@free.length - 1)
+    end
+    idx
+  end
+  def release(idx)
+    @lock.synchronize do
+      @free.push(idx)
+      @cv.signal
+    end
+    nil
+  end
+  def available
+    n = 0
+    @lock.synchronize { n = @free.length }
+    n
+  end
+  def conn(idx)
+    @conns[idx]
+  end
+  def first
+    @conns[0]
+  end
+  def close_all
+    @conns.each { |c| c.close }
+  end
+end
+
+module Db
+  # The shared dispatcher calls SQLite's read-snapshot and WAL hooks.
+  # PostgreSQL keeps its normal READ COMMITTED/autocommit policy here;
+  # its server owns checkpointing. Application transactions still use
+  # transaction_begin/transaction_end below.
+  def self.read_snapshot_begin
+    nil
+  end
+  def self.read_snapshot_end
+    nil
+  end
+  def self.checkpoint_in_background!
+    nil
+  end
+
+  @pools = nil
+  @query_log = nil
+  @prepare_lock = Mutex.new
+
+  def self.configure(conninfo, pool_size: 8)
+    close
+    n = pool_size
+    ev = ENV["DATABASE_POOL_SIZE"]
+    n = ev.to_i if !ev.nil? && !ev.empty?
+    raise "pool_size must be positive" if n < 1
+    stripes = n / 4
+    stripes = 1 if stripes < 1
+    stripes = 8 if stripes > 8
+    @pools = []
+    per = n / stripes
+    i = 0
+    while i < stripes
+      @pools.push(DbPool.new(conninfo, per + (i < n % stripes ? 1 : 0)))
+      i += 1
+    end
+    @assign_lock = Mutex.new
+    @next_pool = 0
+    Thread.current[:db_pool] = nil
+  end
+  def self.pool_for_thread
+    pi = Thread.current[:db_pool]
+    return @pools[pi] if !pi.nil?
+    n = 0
+    @assign_lock.synchronize do
+      n = @next_pool
+      @next_pool += 1
+    end
+    pi = n % @pools.length
+    Thread.current[:db_pool] = pi
+    @pools[pi]
+  end
+  def self.current_conn
+    c = Thread.current[:db_conn]
+    return c if !c.nil?
+    @pools[0].first
+  end
+  def self.in_lease?
+    !Thread.current[:db_conn].nil?
+  end
+  def self.with_connection
+    return yield if in_lease?
+    pool = pool_for_thread
+    idx = pool.lease
+    conn = pool.conn(idx)
+    Thread.current[:db_conn] = conn
+    begin
+      result = yield
+    ensure
+      # libpq connections in INTRANS/INERROR cannot go back to a free pool.
+      if PG.PQtransactionStatus(conn.dbh) != 0
+        r = PG.PQexec(conn.dbh, "ROLLBACK")
+        PG.PQclear(r) if !r.nil?
+      end
+      Thread.current[:db_conn] = nil
+      pool.release(idx)
+    end
+    result
+  end
+  def self.close
+    return nil if @pools.nil?
+    @pools.each { |p| p.close_all }
+    @pools = nil
+    Thread.current[:db_pool] = nil
+    nil
+  end
+  def self.prepare_lock
+    @prepare_lock
+  end
+  # Cache hooks keep the external API; this prototype does not replay rows or
+  # cache prepared statements. Every finalize releases its server statement.
+  def self.query_cache_begin
+    nil
+  end
+  def self.query_cache_end
+    nil
+  end
+  def self.seed_from_file(path)
+    raise "SQLite page backup is unavailable; import PostgreSQL SQL with psql"
+  end
+  def self.capture_sql
+    prev = @query_log
+    log = []
+    @query_log = log
+    begin
+      yield
+    ensure
+      @query_log = prev
+    end
+    log
+  end
+  def self.record_query(sql)
+    @query_log.push(sql) if !@query_log.nil?
+    $stderr.puts("  SQL " + sql) if ENV.fetch("RH_SQL_TRACE", "") != ""
+  end
+  def self.sql_trace?
+    ENV.fetch("RH_SQL_TRACE", "") != ""
+  end
+  def self.check_result(conn, r)
+    raise "libpq returned NULL" if r.nil?
+    status = PG.PQresultStatus(r)
+    if status != PG::COMMAND_OK && status != PG::TUPLES_OK
+      code = PG.PQresultErrorField(r, PG::SQLSTATE)
+      message = PG.PQresultErrorMessage(r)
+      conn.set_sqlstate(code.nil? ? "" : code)
+      PG.PQclear(r)
+      raise ActiveRecord::RecordNotUnique, "SQLSTATE " + conn.sqlstate + ": " + message if conn.sqlstate == "23505"
+      raise "SQLSTATE " + conn.sqlstate + ": " + message
+    end
+    conn.set_sqlstate("")
+    nil
+  end
+  def self.last_error_sqlstate
+    current_conn.sqlstate
+  end
+  def self.unique_violation?(message)
+    message.include?("23505")
+  end
+  def self.exec(sql)
+    record_query(sql)
+    c = current_conn
+    r = PG.PQexec(c.dbh, sql)
+    check_result(c, r)
+    c.set_changes(PG.PQcmdTuples(r).to_i)
+    PG.PQclear(r)
+    nil
+  end
+
+  # Rewrite anonymous binds outside SQL literals, quoted identifiers, dollar
+  # strings and comments. E'...' backslash escapes and nested /* */ are handled.
+  # '?' jsonb operators are ambiguous with the legacy API: write native $n
+  # parameters and use prepare_native for queries containing ?/?|/?& operators.
+  def self.rewrite_placeholders(sql, literals = [])
+    out = ""
+    i = 0
+    n = 0
+    quote = ""
+    dollar = ""
+    line_comment = false
+    depth = 0
+    escape_quote = false
+    while i < sql.length
+      c = sql[i, 1]
+      pair = sql[i, 2]
+      if line_comment
+        out += c
+        line_comment = false if c == "\n"
+      elsif depth > 0
+        if pair == "/*"
+          depth += 1
+          out += pair
+          i += 1
+        elsif pair == "*/"
+          depth -= 1
+          out += pair
+          i += 1
+        else
+          out += c
+        end
+      elsif dollar != ""
+        if sql[i, dollar.length] == dollar
+          out += dollar
+          i += dollar.length - 1
+          dollar = ""
+        else
+          out += c
+        end
+      elsif quote != ""
+        out += c
+        if escape_quote && c == "\\"
+          i += 1
+          out += sql[i, 1].to_s
+        elsif c == quote
+          if sql[i + 1, 1] == quote
+            out += quote
+            i += 1
+          else
+            quote = ""
+          end
+        end
+      elsif pair == "--"
+        line_comment = true
+        out += pair
+        i += 1
+      elsif pair == "/*"
+        depth = 1
+        out += pair
+        i += 1
+      elsif c == "'" || c == '"'
+        quote = c
+        prev = i > 0 ? sql[i - 1, 1] : ""
+        escape_quote = c == "'" && (prev == "E" || prev == "e")
+        out += c
+      elsif c == "$"
+        rest = sql[i, sql.length - i]
+        tag = rest.match(/\A\$(?:[A-Za-z_][A-Za-z_0-9]*)?\$/)
+        if !tag.nil?
+          dollar = tag[0]
+          out += dollar
+          i += dollar.length - 1
+        else
+          out += c
+        end
+      elsif c == "?"
+        n += 1
+        out += literals.empty? ? "$" + n.to_s : literals[n - 1].to_s
+      else
+        out += c
+      end
+      i += 1
+    end
+    out
+  end
+  def self.interpolate(sql, literals)
+    rewrite_placeholders(sql, literals)
+  end
+  def self.prepare(sql)
+    sql = ActiveRecord::Relation.inline_sql(sql)
+    prepare_native(rewrite_placeholders(sql))
+  end
+  def self.prepare_native(sql)
+    record_query(sql)
+    c = current_conn
+    name = c.next_name
+    r = PG.PQprepare(c.dbh, name, sql, 0, nil)
+    check_result(c, r)
+    PG.PQclear(r)
+    description = PG.PQdescribePrepared(c.dbh, name)
+    check_result(c, description)
+    PgStmt.new(c, name, description)
+  end
+  def self.step?(stmt)
+    stmt.advance
+  end
+  def self.finalize(stmt)
+    stmt.close
+  end
+  def self.bind_int(stmt, idx, value)
+    stmt.bind(idx, value.to_i.to_s)
+  end
+  def self.bind_text(stmt, idx, value)
+    raise "PostgreSQL text cannot contain NUL" if value.include?("\0")
+    stmt.bind(idx, value)
+  end
+  def self.bind_bool(stmt, idx, value)
+    stmt.bind(idx, value ? "true" : "false")
+  end
+  def self.bind_null(stmt, idx)
+    stmt.bind(idx, nil)
+  end
+  def self.prepare_uncached(sql)
+    prepare(sql)
+  end
+  def self.bind_int_opt(stmt, idx, value)
+    value.nil? ? bind_null(stmt, idx) : bind_int(stmt, idx, value)
+  end
+  def self.bind_text_opt(stmt, idx, value)
+    value.nil? ? bind_null(stmt, idx) : bind_text(stmt, idx, value)
+  end
+  def self.bind_bool_opt(stmt, idx, value)
+    value.nil? ? bind_null(stmt, idx) : bind_bool(stmt, idx, value)
+  end
+  def self.bind_float(stmt, idx, value)
+    stmt.bind(idx, value.to_f.to_s)
+  end
+  def self.column_null?(stmt, i)
+    PG.PQgetisnull(stmt.result, stmt.row, i) != 0
+  end
+  def self.column_text(stmt, i)
+    return "" if column_null?(stmt, i)
+    text = PG.PQgetvalue(stmt.result, stmt.row, i)
+    oid = PG.PQftype(stmt.result, i)
+    if oid == 1114 || oid == 1184
+      fraction = text.length > 19 && text[19, 1] == "." ? text[20, 6].to_s.split("+")[0].to_s : ""
+      text = text[0, 19] + "." + (fraction + "000000")[0, 6]
+    end
+    text
+  end
+  def self.column_int(stmt, i)
+    column_text(stmt, i).to_i
+  end
+  def self.column_float(stmt, i)
+    column_text(stmt, i).to_f
+  end
+  def self.column_bool(stmt, i)
+    s = column_text(stmt, i)
+    s == "t" || s == "true" || s == "1"
+  end
+  def self.column_int_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_int(stmt, i)
+  end
+  def self.column_float_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_float(stmt, i)
+  end
+  def self.column_text_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_text(stmt, i)
+  end
+  def self.column_bool_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_bool(stmt, i)
+  end
+  def self.column_value(stmt, i)
+    return nil if column_null?(stmt, i)
+    oid = PG.PQftype(stmt.result, i)
+    return column_bool(stmt, i) if oid == 16
+    return column_int(stmt, i) if oid == 20 || oid == 21 || oid == 23 || oid == 26
+    return column_float(stmt, i) if oid == 700 || oid == 701
+    return column_array(stmt, i) if oid == 1009
+    # NUMERIC (1700) stays a string to preserve decimal precision. Arrays,
+    # jsonb, uuid, timestamp, bytea text require schema-aware decoding above Db.
+    column_text(stmt, i)
+  end
+  def self.column_count(stmt)
+    PG.PQnfields(stmt.result)
+  end
+  def self.column_name(stmt, i)
+    PG.PQfname(stmt.result, i)
+  end
+  def self.changes
+    current_conn.changes
+  end
+  # Legacy integer-id compatibility only: session-local lastval(), unchanged
+  # by SELECT. Triggers can choose a different sequence; UUIDs have none.
+  # Lowered inserts use RETURNING; this is only the legacy facade fallback.
+  def self.last_insert_rowid
+    c = current_conn
+    r = PG.PQexec(c.dbh, "SELECT lastval()")
+    check_result(c, r)
+    n = PG.PQgetvalue(r, 0, 0).to_i
+    PG.PQclear(r)
+    n
+  end
+  def self.escape_string(s)
+    text = s.to_s
+    raise "PostgreSQL text cannot contain NUL" if text.include?("\0")
+    ptr = PG.PQescapeLiteral(current_conn.dbh, text, text.bytesize)
+    raise "PQescapeLiteral failed" if ptr.nil?
+    # :str duplicates foreign bytes into a GC string before freeing libpq's
+    # allocation. No process-global scratch buffer, including across threads.
+    quoted = PG.rh_pg_string(ptr)
+    PG.PQfreemem(ptr)
+    quoted
+  end
+  def self.escape_int(n)
+    n.to_i.to_s
+  end
+  def self.escape_bool(b)
+    b ? "TRUE" : "FALSE"
+  end
+  def self.escape_string_opt(s)
+    s.nil? ? "NULL" : escape_string(s)
+  end
+  def self.escape_int_opt(n)
+    n.nil? ? "NULL" : escape_int(n)
+  end
+  def self.escape_float_opt(f)
+    f.nil? ? "NULL" : f.to_f.to_s
+  end
+  def self.escape_bool_opt(b)
+    b.nil? ? "NULL" : escape_bool(b)
+  end
+  def self.escape_int_list(ids)
+    ids.empty? ? "NULL" : ids.map { |i| i.to_i.to_s }.join(", ")
+  end
+  # Explicit lifecycle lets framework yield directly, avoiding nested forwarding.
+  def self.transaction_begin
+    pool = pool_for_thread
+    idx = -1
+    if !in_lease?
+      idx = pool.lease
+      Thread.current[:db_conn] = pool.conn(idx)
+    end
+    outermost = PG.PQtransactionStatus(current_conn.dbh) == 0
+    exec("BEGIN") if outermost
+    PgTransaction.new(pool, idx, outermost)
+  end
+  def self.transaction_end(tx, commit)
+    begin
+      exec(commit ? "COMMIT" : "ROLLBACK") if tx.outermost
+    ensure
+      if tx.idx >= 0
+        conn = current_conn
+        if PG.PQtransactionStatus(conn.dbh) != 0
+          r = PG.PQexec(conn.dbh, "ROLLBACK")
+          PG.PQclear(r) if !r.nil?
+        end
+        Thread.current[:db_conn] = nil
+        tx.pool.release(tx.idx)
+      end
+    end
+    nil
+  end
+  def self.transaction
+    tx = transaction_begin
+    commit = false
+    begin
+      result = yield
+      commit = true
+    ensure
+      transaction_end(tx, commit)
+    end
+    result
+  end
+
+end
+
+module Db
+  def self.prepare_schema(path)
+    transaction do
+      exec("SELECT pg_advisory_xact_lock(7421930501)")
+      stmt = prepare("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = 'public' AND table_type = 'BASE TABLE'")
+      step?(stmt)
+      count = column_int(stmt, 0)
+      finalize(stmt)
+      if count == 0
+        exec(File.read(path))
+        exec("SET search_path = public")
+      end
+    end
+    nil
+  end
+  def self.insert_returning_int(sql)
+    stmt = prepare(sql)
+    begin
+      raise "INSERT returned no primary key" unless step?(stmt)
+      id = column_int(stmt, 0)
+    ensure
+      finalize(stmt)
+    end
+    id
+  end
+  def self.insert_returning_text(sql)
+    stmt = prepare(sql)
+    begin
+      raise "INSERT returned no primary key" unless step?(stmt)
+      id = column_text(stmt, 0)
+    ensure
+      finalize(stmt)
+    end
+    id
+  end
+  def self.prepare_locked(sql)
+    prepare(sql + " FOR UPDATE")
+  end
+  def self.column_array(stmt, i)
+    decode_array(column_text(stmt, i))
+  end
+  def self.column_array_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_array(stmt, i)
+  end
+  # One-dimensional, non-null text[]; quoted wire elements preserve NULL text.
+  def self.decode_array(text)
+    values = []
+    return values if text == "{}" || text == ""
+    value = ""
+    quoted = false
+    escaped = false
+    i = 1
+    while i < text.length - 1
+      c = text[i, 1]
+      if escaped
+        value += c
+        escaped = false
+      elsif c == "\\"
+        escaped = true
+      elsif c == '"'
+        quoted = !quoted
+      elsif c == "," && !quoted
+        values.push(value)
+        value = ""
+      else
+        value += c
+      end
+      i += 1
+    end
+    values.push(value)
+    values
+  end
+  def self.encode_array(values)
+    encoded = values.map do |v|
+      out = '"'
+      v.each_char do |c|
+        out += "\\" if c == "\\" || c == '"'
+        out += c
+      end
+      out + '"'
+    end
+    "{" + encoded.join(",") + "}"
+  end
+  def self.escape_array(values)
+    escape_string(encode_array(values)) + "::text[]"
+  end
+  def self.escape_array_opt(values)
+    values.nil? ? "NULL" : escape_array(values)
+  end
+
+end
+
+class PgTransaction
+  attr_reader :pool, :idx, :outermost
+  def initialize(pool, idx, outermost)
+    @pool = pool
+    @idx = idx
+    @outermost = outermost
+  end
+end
+
+module Db
+  def self.quote_identifier(name)
+    '"' + name.gsub('"', '""') + '"'
+  end
+end
+
+module Db
+  def self._txn_depth
+    d = Thread.current[:ar_txn_depth]
+    d.nil? ? 0 : d
+  end
+
+  def self._txn_depth=(value)
+    Thread.current[:ar_txn_depth] = value
+  end
+
+  # Bit `depth - 1` of this integer is whether that frame can be joined.
+  # Same thread slot as the depth. See runtime/ruby/db.rbs.
+  def self._txn_joinable_bits
+    bits = Thread.current[:ar_txn_joinable_bits]
+    bits.nil? ? 0 : bits
+  end
+
+  def self._txn_joinable_bits=(value)
+    Thread.current[:ar_txn_joinable_bits] = value
+  end
+
+  # The open transaction's enlisted writes (connection.rb), held in the
+  # same per-thread storage as the depth.
+  def self._txn_records
+    records = Thread.current[:ar_txn_records]
+    if records.nil?
+      records = [ActiveRecord::EnlistedRecord.new(ActiveRecord::Base.new, 0)]
+      records.clear
+      Thread.current[:ar_txn_records] = records
+    end
+    records
+  end
+
+  # The work `current_transaction.after_commit` holds for the COMMIT
+  # (ActiveRecord::Base._after_commit), beside the records above. Seeded
+  # and cleared, as the records are, so the element type is the work's.
+  def self._txn_callbacks
+    work = Thread.current[:ar_txn_callbacks]
+    if work.nil?
+      work = [-> { nil }]
+      work.clear
+      Thread.current[:ar_txn_callbacks] = work
+    end
+    work
+  end
+
+  def self.transaction_open?
+    PG.PQtransactionStatus(current_conn.dbh) != 0
+  end
+
+  def self.database_path
+    ENV.fetch("DATABASE_URL")
+  end
+
+  def self.adapter_name
+    "postgresql"
+  end
+end
