diff --git a/test/rbs-seed/oint_arg_through_self_dispatch.rb b/test/rbs-seed/oint_arg_through_self_dispatch.rb
new file mode 100644
index 000000000..489c359c9
--- /dev/null
+++ b/test/rbs-seed/oint_arg_through_self_dispatch.rb
@@ -0,0 +1,20 @@
+# spinel: rbs-seed-run
+# An inherited method's call dispatches on the receiver's class, and an
+# override whose parameter is `Integer?` (or `Float?`) takes the argument
+# with its nil: the arm unboxed it as a plain Integer, which nil raises on,
+# and passed an sp_int where the override takes the oint (#9398).
+class OintDispatchBase
+  def f(x) = raise NotImplementedError
+  def g = f(nil)
+  def h(v) = f(v)
+  def q(x) = raise NotImplementedError
+  def r = q(nil)
+end
+class OintDispatchSub < OintDispatchBase
+  def f(x) = x
+  def q(x) = x
+end
+s = OintDispatchSub.new
+p s.g
+p s.h(5)
+p s.r
diff --git a/test/rbs-seed/sig/oint_arg_through_self_dispatch.rbs b/test/rbs-seed/sig/oint_arg_through_self_dispatch.rbs
new file mode 100644
index 000000000..394b77540
--- /dev/null
+++ b/test/rbs-seed/sig/oint_arg_through_self_dispatch.rbs
@@ -0,0 +1,9 @@
+class OintDispatchBase
+  def f: (untyped x) -> untyped
+  def h: (Integer? v) -> untyped
+  def q: (untyped x) -> untyped
+end
+class OintDispatchSub < OintDispatchBase
+  def f: (Integer? x) -> Integer?
+  def q: (Float? x) -> Float?
+end
