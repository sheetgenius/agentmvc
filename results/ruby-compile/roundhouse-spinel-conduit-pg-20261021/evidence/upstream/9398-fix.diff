commit e7ad51d7f080825055e0bcb876f6ef597aeee695
Author: Yukihiro "Matz" Matsumoto <[redacted-email]>
Date:   Sat Oct 17 07:05:25 2026 +0900

    A dispatch arm hands an Integer? parameter the oint its box holds
    
    An inherited method's call that dispatches on the receiver's class held
    its arguments boxed and unboxed each for the arm's parameter. A
    parameter that holds its nil (`Integer?`, `Float?`) got the plain unbox,
    which raises on nil and answers an sp_int where the override takes the
    oint, so the C did not compile (since a07741ff1). Such a parameter now
    takes the box's oint, its nil kept (emit_unbox_nilable_text).
    
    Fixes #9398
    
    Co-Authored-By: Claude <[redacted-email]>

diff --git a/src/codegen_fold.c b/src/codegen_fold.c
index 911e5b927..683d87302 100644
--- a/src/codegen_fold.c
+++ b/src/codegen_fold.c
@@ -12162,6 +12162,8 @@ static void emit_arm_arg(Compiler *c, Scope *arm, int a, int atmp_id, TyKind fro
   else if (from_o && pt == from && !pto) buf_printf(b, "%s(%s)", oint_arg(pt), tn);
   else if (!from_o && pt == from && pto) buf_printf(b, "%s(%s)", oint_of(pt), tn);
   else if (pt == TY_POLY && from != TY_POLY && from != TY_UNKNOWN) emit_boxed_text(c, from, tn, b);
+  /* (a parameter that holds its nil takes the box's oint, nil kept: #9398) */
+  else if (from == TY_POLY && pt != TY_POLY && pt != TY_UNKNOWN && pto) emit_unbox_nilable_text(c, pt, tn, b);
   else if (from == TY_POLY && pt != TY_POLY && pt != TY_UNKNOWN) emit_unbox_text(c, pt, tn, b);
   else buf_puts(b, tn);
 }
