index f00e6a67..3274c05a 100644
--- a/src/lower/errors_index.rs
+++ b/src/lower/errors_index.rs
@@ -145,6 +145,23 @@ fn rewrite_messages(expr: &mut Expr, diags: &mut Vec<Diagnostic>) {
 }
 
 fn rewrite(expr: &mut Expr, diags: &mut Vec<Diagnostic>) {
+    // The retained structured entries support Rails' symbolic error predicate.
+    // String-message predicates are a different contract and remain unclaimed.
+    if let ExprNode::Send { recv: Some(r), method, args, block: None, .. } = &*expr.node {
+        if method.as_str() == "of_kind?" && is_errors_read(r) && args.len() == 2
+            && args.iter().all(|a| matches!(&*a.node, ExprNode::Lit { value: Literal::Sym { .. } }))
+        {
+            let ExprNode::Send { recv, .. } = &*r.node else { unreachable!() };
+            *expr.node = ExprNode::Send {
+                recv: recv.clone(), method: Symbol::from("errors_of_kind?"), args: args.clone(),
+                block: None, parenthesized: true,
+            };
+            expr.ty = Some(Ty::Bool);
+        } else if method.as_str() == "of_kind?" && is_errors_read(r) {
+            diags.push(Diagnostic::unsupported(expr.span, None, "errors.of_kind?",
+                "only two literal Symbol arguments are implemented"));
+        }
+    }
     if let ExprNode::Send { recv: Some(r), method, block: Some(_), .. } = &mut *expr.node {
         if matches!(method.as_str(), "any?" | "each" | "map") && is_errors_read(r) {
             if let ExprNode::Send { method, .. } = &mut *r.node { *method = Symbol::from("errors_entries"); }
