@@ -0,0 +1,59 @@
+//! Small framework surfaces exercised by the integrated native application gate.
+use std::collections::HashMap;
+use std::path::PathBuf;
+use roundhouse::{App, emit::{ruby, EmittedFile}, ingest::ingest_app_from_tree};
+
+fn app(controller: &str) -> App {
+    let tree: HashMap<PathBuf, Vec<u8>> = [
+        ("db/schema.rb", "ActiveRecord::Schema.define do; create_table 'records' do |t|; t.string 'name'; end; end"),
+        ("app/models/application_record.rb", "class ApplicationRecord < ActiveRecord::Base; primary_abstract_class; end"),
+        ("app/models/record.rb", "class Record < ApplicationRecord; validates :name, uniqueness: true; end"),
+        ("app/controllers/probes_controller.rb", controller),
+    ].into_iter().map(|(p, c)| (PathBuf::from(p), c.as_bytes().to_vec())).collect();
+    let mut app = ingest_app_from_tree(tree).unwrap();
+    roundhouse::session::analyze_and_lower(&mut app);
+    app
+}
+fn file(files: Vec<EmittedFile>, suffix: &str) -> String {
+    files.into_iter().find(|f| f.path.to_string_lossy().ends_with(suffix)).unwrap().content
+}
+#[test]
+fn record_with_lock_is_known_and_preserved() {
+    let app = app("class ProbesController < ApplicationController; def index; record = Record.first; record.with_lock { record.update!(name: 'updated') }; end; end");
+    let diagnostics = roundhouse::analyze::diagnose(&app);
+    let failures: Vec<_> = diagnostics.iter().filter(|d| d.message.contains("with_lock")).collect();
+    assert!(failures.is_empty(), "{failures:?}");
+    let src = file(ruby::emit_lowered_controllers(&app), "probes_controller.rb");
+    assert!(src.contains("record.with_lock"), "{src}");
+    let runtime = std::fs::read_to_string("runtime/ruby/active_record/connection.rb").unwrap();
+    assert!(runtime.contains("def with_lock") && runtime.contains("reload(lock: true)"));
+}
+#[test]
+fn symbolic_error_predicate_uses_structured_entries() {
+    let app = app("class ProbesController < ApplicationController; def index; record = Record.new(name: 'test'); record.save; render json: { taken: record.errors.of_kind?(:name, :taken), errors: record.errors.to_hash }; end; end");
+    let src = file(ruby::emit_lowered_controllers(&app), "probes_controller.rb");
+    assert!(src.contains("record.errors_of_kind?(:name, :taken)"), "{src}");
+    assert!(src.contains("record.errors_messages"), "{src}");
+    assert!(!src.contains(".of_kind?"), "{src}");
+    let errors: Vec<_> = roundhouse::analyze::diagnose(&app).into_iter()
+        .filter(|d| d.severity == roundhouse::diagnostic::Severity::Error).collect();
+    assert!(errors.is_empty(), "{errors:?}");
+}
+#[test]
+fn string_error_predicate_remains_unclaimed() {
+    let mut app = app("class ProbesController < ApplicationController; def index; record = Record.new; record.errors.of_kind?(:name, 'has already been taken'); end; end");
+    let diagnostics = roundhouse::lower::apply_errors_index_lowering(&mut app);
+    assert!(diagnostics.iter().any(|d| d.severity == roundhouse::diagnostic::Severity::Error
+        && d.message.contains("only two literal Symbol")), "{diagnostics:?}");
+    let src = file(ruby::emit_lowered_controllers(&app), "probes_controller.rb");
+    assert!(src.contains(".of_kind?(:name, \"has already been taken\")"), "{src}");
+}
+
+#[test]
+fn error_predicate_runtime_matches_attribute_and_type() {
+    let result = std::process::Command::new("ruby").args([
+        "-I", "runtime/ruby", "-e",
+        "require 'active_record/base'; r = ActiveRecord::Base.new; raise if r.errors_of_kind?(:name, :taken); r.record_validation_message(:name, 'has already been taken', :taken); raise unless r.errors_of_kind?(:name, :taken); raise if r.errors_of_kind?(:other, :taken); raise if r.errors_of_kind?(:name, :invalid)"
+    ]).output().expect("Ruby runtime execution");
+    assert!(result.status.success(), "{}", String::from_utf8_lossy(&result.stderr));
+}
