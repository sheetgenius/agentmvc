--- a/tests/secure_password_lowering.rs
+++ b/tests/secure_password_lowering.rs
@@ -91,3 +91,26 @@ fn secure_password_renders_on_the_ruby_tree() {
         "writer must render the digest store: {user_src}",
     );
 }
+
+#[test]
+fn secure_password_override_super_retains_generated_writer() {
+    for call in ["super", "super(value)"] {
+        let app = app_with(&format!(
+            "class User < ApplicationRecord\n  has_secure_password\n  def password=(value)\n    @supplied = true\n    {call}\n  end\nend\n"
+        ));
+        let files = roundhouse::emit::ruby::emit_lowered_models(&app);
+        let source = &files.iter().find(|f| f.path.to_string_lossy().ends_with("models/user.rb")).unwrap().content;
+        assert!(source.contains("__rh_secure_password_writer(value)"), "{source}");
+        assert!(source.contains("@supplied = true"), "{source}");
+        assert!(source.contains("BCrypt::Password.create(unencrypted_password)"), "{source}");
+    }
+}
+
+#[test]
+fn supplied_nil_password_routes_through_writer() {
+    let app = app_with("class User < ApplicationRecord\n  has_secure_password\nend\n");
+    let files = roundhouse::emit::ruby::emit_lowered_models(&app);
+    let source = &files.iter().find(|f| f.path.to_string_lossy().ends_with("models/user.rb")).unwrap().content;
+    assert!((source.contains("self.password = attrs[:password] if attrs.key?(:password)") || source.contains("self.password = attrs[:password] if attrs.key? :password")), "{source}");
+    assert!(!source.contains("self.password = attrs[:password] if !(attrs[:password].nil?)"), "{source}");
+}
