diff --git a/src/lower/secure_password.rs b/src/lower/secure_password.rs
index e4df796e..c2d7c88b 100644
--- a/src/lower/secure_password.rs
+++ b/src/lower/secure_password.rs
@@ -469,3 +469,40 @@ fn plaintext_writer_body(attr: &Symbol, digest: &Symbol) -> Expr {
     });
     sp_expr(ExprNode::Seq { exprs: vec![store_plain, guarded_digest] })
 }
+
+
+/// A model override calls the macro's generated module method via super.
+/// Flatten that one inherited writer into a private lowering helper instead
+/// of letting super dispatch to ActiveRecord::Base (which has no such writer).
+pub(crate) fn lower_secure_password_super(methods: &mut Vec<MethodDef>, model: &Model) {
+    let Some(attr) = secure_password_attr(&model.body) else { return; };
+    let writer = Symbol::from(format!("{}=", attr.as_str()));
+    let helper = Symbol::from(format!("__rh_secure_{}_writer", attr.as_str()));
+    let mut rewritten = false;
+    for method in methods.iter_mut() {
+        if method.name != writer { continue; }
+        let forwarded: Vec<Expr> = method.params.iter().map(|p| sp_expr(ExprNode::Var {
+            id: VarId(0), name: p.name.clone(),
+        })).collect();
+        fn rewrite(e: &mut Expr, helper: &Symbol, forwarded: &[Expr]) -> bool {
+            if let ExprNode::Super { args } = &*e.node {
+                let args = args.clone().unwrap_or_else(|| forwarded.to_vec());
+                e.node = Box::new(ExprNode::Send {
+                    recv: None, method: helper.clone(), args, block: None, parenthesized: true,
+                });
+                return true;
+            }
+            let mut changed = false;
+            e.node.for_each_child_mut(&mut |c| changed |= rewrite(c, helper, forwarded));
+            changed
+        }
+        rewritten |= rewrite(&mut method.body, &helper, &forwarded);
+    }
+    if rewritten {
+        let plain = Symbol::from("unencrypted_password");
+        let digest = Symbol::from(format!("{}_digest", attr.as_str()));
+        push_synth_instance_method(methods, model, helper,
+            vec![Param::positional(plain.clone())], plaintext_writer_body(&attr, &digest),
+            Some(fn_sig(vec![(plain, Ty::Str)], Ty::Nil)), AccessorKind::Method, true);
+    }
+}
