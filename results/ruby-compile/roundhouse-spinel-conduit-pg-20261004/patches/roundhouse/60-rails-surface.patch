+            "scope" => {
+                if let Some(name) = symbol_value(&pair.value()) { scope.push(Symbol::from(name.as_str())); }
+                else if let Some(names) = pair.value().as_array_node() {
+                    for n in names.elements().iter() { scope.push(Symbol::from(symbol_value(&n)?.as_str())); }
+                } else { return None }
+            }
