diff --git a/src/ingest/boot_hooks.rs b/src/ingest/boot_hooks.rs
new file mode 100644
index 00000000..46a798e8
--- /dev/null
+++ b/src/ingest/boot_hooks.rs
@@ -0,0 +1,168 @@
+//! Lift zero-argument Rails config.after_initialize blocks into app methods.
+//! The Spinel server invokes them after DB/queue setup, before listening.
+//! A Rails::Server registration guard is true at that entry point; it keeps
+//! the original Rails source from running recovery during rake/assets tasks.
+
+use super::{IngestError, IngestResult};
+use ruby_prism::Node;
+
+pub(super) fn extract(source: &[u8], file: &str) -> IngestResult<Vec<String>> {
+    fn walk(
+        stmts: Vec<Node<'_>>,
+        src: &str,
+        file: &str,
+        out: &mut Vec<String>,
+    ) -> IngestResult<()> {
+        for stmt in stmts {
+            if let Some(class) = stmt.as_class_node() {
+                walk(
+                    class
+                        .body()
+                        .map(super::util::flatten_statements)
+                        .unwrap_or_default(),
+                    src,
+                    file,
+                    out,
+                )?;
+                continue;
+            }
+            if let Some(module) = stmt.as_module_node() {
+                walk(
+                    module
+                        .body()
+                        .map(super::util::flatten_statements)
+                        .unwrap_or_default(),
+                    src,
+                    file,
+                    out,
+                )?;
+                continue;
+            }
+            if let Some(guard) = stmt.as_if_node() {
+                let condition = guard.predicate();
+                let loc = condition.location();
+                let text: String = src[loc.start_offset()..loc.end_offset()]
+                    .chars()
+                    .filter(|c| !c.is_whitespace())
+                    .collect();
+                let mut nested = Vec::new();
+                walk(
+                    guard
+                        .statements()
+                        .map(|s| s.body().iter().collect())
+                        .unwrap_or_default(),
+                    src,
+                    file,
+                    &mut nested,
+                )?;
+                if let Some(branch) = guard.subsequent() {
+                    if let Some(otherwise) = branch.as_else_node() {
+                        walk(
+                            otherwise
+                                .statements()
+                                .map(|s| s.body().iter().collect())
+                                .unwrap_or_default(),
+                            src,
+                            file,
+                            &mut nested,
+                        )?;
+                    } else {
+                        walk(vec![branch], src, file, &mut nested)?;
+                    }
+                }
+                // Other registration guards cannot be discarded: their value
+                // at Rails initialization need not equal their value at boot.
+                if !nested.is_empty()
+                    && (text != "defined?(Rails::Server)" || guard.subsequent().is_some())
+                {
+                    return Err(IngestError::Unsupported { file: file.into(),
+                        message: "after_initialize registration supports only an unguarded block or if defined?(Rails::Server) without else".into() });
+                }
+                out.extend(nested);
+                continue;
+            }
+            if let Some(guard) = stmt.as_unless_node() {
+                let mut nested = Vec::new();
+                walk(
+                    guard
+                        .statements()
+                        .map(|s| s.body().iter().collect())
+                        .unwrap_or_default(),
+                    src,
+                    file,
+                    &mut nested,
+                )?;
+                if let Some(branch) = guard.else_clause() {
+                    walk(
+                        branch
+                            .statements()
+                            .map(|s| s.body().iter().collect())
+                            .unwrap_or_default(),
+                        src,
+                        file,
+                        &mut nested,
+                    )?;
+                }
+                if !nested.is_empty() {
+                    return Err(IngestError::Unsupported {
+                        file: file.into(),
+                        message: "after_initialize registration does not support unless guards"
+                            .into(),
+                    });
+                }
+                continue;
+            }
+            let Some(call) = stmt.as_call_node() else {
+                continue;
+            };
+            let name = super::util::constant_id_str(&call.name());
+            if name == "configure" {
+                if let Some(body) = call
+                    .block()
+                    .and_then(|b| b.as_block_node())
+                    .and_then(|b| b.body())
+                {
+                    walk(super::util::flatten_statements(body), src, file, out)?;
+                }
+                continue;
+            }
+            if name != "after_initialize"
+                || super::app::config_receiver_path(&call.receiver()) != Some(Vec::new())
+            {
+                continue;
+            }
+            let block = call.block().and_then(|b| b.as_block_node());
+            let Some(block) = block else {
+                return Err(IngestError::Unsupported {
+                    file: file.into(),
+                    message: "after_initialize requires a literal zero-argument block".into(),
+                });
+            };
+            if block.parameters().is_some() || call.arguments().is_some() {
+                return Err(IngestError::Unsupported {
+                    file: file.into(),
+                    message: "after_initialize requires a literal zero-argument block".into(),
+                });
+            }
+            let body = block
+                .body()
+                .map(|b| {
+                    let loc = b.location();
+                    src[loc.start_offset()..loc.end_offset()].to_string()
+                })
+                .unwrap_or_default();
+            out.push(body);
+        }
+        Ok(())
+    }
+    let parsed = super::prism::parse(source, file);
+    let root = parsed.node();
+    let stmts = root
+        .as_program_node()
+        .map(|p| p.statements().body().iter().collect())
+        .unwrap_or_default();
+    let src = String::from_utf8_lossy(source);
+    let mut hooks = Vec::new();
+    walk(stmts, &src, file, &mut hooks)?;
+    Ok(hooks)
+}
