# syntax=docker/dockerfile:1
# Compiled production image for the Conduit compile variant (Roundhouse -> Spinel, PostgreSQL/libpq lane).
# Toolchain: roundhouse 25609ca3 + patches/series, Spinel 813def1fb + spinel-cgroup-workers.patch + spinel-poly-dispatch-arg-roots.patch (see SHA256SUMS).
ARG TOOLCHAIN_IMAGE=spinel-spike-lead-toolchain:83918594c522
FROM ${TOOLCHAIN_IMAGE} AS toolchain
RUN echo '83918594c52258f616fe65b1214510e1119f6e5a265802c65f53bb7edebc57b2  /usr/local/share/roundhouse-patches/SHA256SUMS' | sha256sum -c -

FROM toolchain AS build
ENV RH_DATABASE_ADAPTER=postgresql CC=clang MAKEFLAGS=-j8
WORKDIR /src/app
COPY . .
RUN roundhouse check /src/app && roundhouse --target spinel -o /build /src/app
WORKDIR /build
RUN spin build -- --cc=clang --jobs=8 \
    && mkdir -p /runtime/static /runtime/public /runtime/db /runtime/config /runtime/storage \
    && set -- build/bin/* && test "$#" -eq 1 && test -x "$1" \
    && install -m755 "$1" /runtime/server && strip /runtime/server \
    && for dir in static public db config; do if [ -d "$dir" ]; then cp -a "$dir/." "/runtime/$dir/"; fi; done \
    && test -s /runtime/db/structure.sql && ldd /runtime/server

FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd AS runtime
RUN apt-get update -qq \
    && apt-get install --no-install-recommends -y libpq5 libjemalloc2 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home --home-dir /app app
WORKDIR /app
COPY --from=build --chown=10001:10001 /runtime/ ./
USER 10001:10001
# No worker count is baked in: Spinel derives OS workers from the container's cgroup CPU quota at startup
# (see the boot banner). PORT is supplied by the runtime contract.
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/server"]
