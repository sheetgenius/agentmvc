diff --git a/lib/sp_resource.c b/lib/sp_resource.c
new file mode 100644
index 000000000..9a8a26f63
--- /dev/null
+++ b/lib/sp_resource.c
@@ -0,0 +1,227 @@
+/* sp_resource.c -- container-aware defaults; no allocation on the hot path. */
+#ifdef __linux__
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#endif
+#include "sp_resource.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <limits.h>
+#include <unistd.h>
+#include <errno.h>
+#ifdef __linux__
+#include <sched.h>
+#endif
+
+typedef struct {
+  unsigned long long quota, period;
+  size_t memory;
+  int version;
+} sp_limits;
+
+#ifdef __linux__
+/* Controller names are tokens, not substrings (cpu != cpuacct). */
+static int sp_controller(const char *list, const char *name) {
+  size_t n = strlen(name);
+  while (*list) {
+    const char *end = strchr(list, ',');
+    size_t len = end ? (size_t)(end - list) : strlen(list);
+    if (len == n && memcmp(list, name, n) == 0) return 1;
+    if (!end) break;
+    list = end + 1;
+  }
+  return 0;
+}
+
+static int sp_cgroup_path(const char *file, const char *controller, char *path, size_t cap) {
+  FILE *f = fopen(file, "r");
+  if (!f) return 0;
+  char line[4096]; int found = 0;
+  while (fgets(line, sizeof line, f)) {
+    char *a = strchr(line, ':'), *b = a ? strchr(a + 1, ':') : NULL;
+    if (!b) continue;
+    *b++ = 0; b[strcspn(b, "\r\n")] = 0;
+    if (controller ? sp_controller(a + 1, controller) : a[1] == 0) {
+      /* Reject namespace paths escaping the visible mount. */
+      if (*b == '/' && !strstr(b, "/../") && strcmp(b, "/..") != 0 && strlen(b) < cap) {
+        strcpy(path, b); found = 1; break;
+      }
+    }
+  }
+  fclose(f); return found;
+}
+
+/* mountinfo supplies both the mount point and its hierarchy root: a bind mount
+   may expose only a subtree. cgroup namespaces usually report path "/". */
+static int sp_cgroup_mount(const char *file, const char *controller, const char *group,
+                           char *dir, size_t cap, size_t *root_len) {
+  FILE *f = fopen(file, "r");
+  if (!f) return 0;
+  char line[8192]; int found = 0;
+  while (fgets(line, sizeof line, f)) {
+    char root[4096], mount[4096], type[32], device[256], opts[256];
+    char *sep = strstr(line, " - ");
+    if (!sep || sscanf(line, "%*s %*s %*s %4095s %4095s", root, mount) != 2 ||
+        sscanf(sep + 3, "%31s %255s %255s", type, device, opts) != 3) continue;
+    if (controller ? (strcmp(type, "cgroup") != 0 || !sp_controller(opts, controller))
+                   : strcmp(type, "cgroup2") != 0) continue;
+    /* Escaped mount names are uncommon; leave them to the affinity fallback
+       rather than accidentally reading an unrelated path. */
+    if (strchr(mount, '\\') || strchr(root, '\\')) continue;
+    const char *suffix = group;
+    size_t n = strlen(root);
+    if (strcmp(root, "/") != 0 && strncmp(group, root, n) == 0 &&
+        (group[n] == '/' || group[n] == 0)) suffix = group + n;
+    int len = snprintf(dir, cap, "%s%s", mount, strcmp(suffix, "/") == 0 ? "" : suffix);
+    if (len > 0 && (size_t)len < cap) { *root_len = strlen(mount); found = 1; break; }
+  }
+  fclose(f); return found;
+}
+
+static int sp_limit_number(const char *s, unsigned long long *n, char **end) {
+  if (*s < '0' || *s > '9') return 0;
+  errno = 0; *n = strtoull(s, end, 10);
+  return errno == 0 && *n > 0;
+}
+
+static int sp_limit_read(const char *dir, const char *name, char *buf, size_t cap) {
+  char path[8192];
+  int n = snprintf(path, sizeof path, "%s/%s", dir, name);
+  if (n < 0 || (size_t)n >= sizeof path) return 0;
+  FILE *f = fopen(path, "r");
+  if (!f) return 0;
+  int ok = fgets(buf, (int)cap, f) != NULL;
+  fclose(f); return ok;
+}
+
+/* Visit every visible ancestor. Limits above a cgroup namespace's mount root
+   cannot be read; the kernel still enforces them. */
+static void sp_cgroup_limits(const char *cgroup, const char *mountinfo,
+                             const char *controller, sp_limits *lim) {
+  char group[4096], dir[8192], buf[256]; size_t root_len;
+  if (!sp_cgroup_path(cgroup, controller, group, sizeof group) ||
+      !sp_cgroup_mount(mountinfo, controller, group, dir, sizeof dir, &root_len)) return;
+  int v2 = controller == NULL;
+  do {
+    unsigned long long q = 0, p = 0; char *end;
+    if (v2 && sp_limit_read(dir, "cpu.max", buf, sizeof buf) &&
+        sp_limit_number(buf, &q, &end)) {
+      while (*end == ' ' || *end == '\t') end++;
+      if (!sp_limit_number(end, &p, &end) || end[strspn(end, " \t\r\n")] != 0) p = 0;
+    } else if (!v2 && strcmp(controller, "cpu") == 0 &&
+               sp_limit_read(dir, "cpu.cfs_quota_us", buf, sizeof buf) &&
+               sp_limit_number(buf, &q, &end) &&
+               sp_limit_read(dir, "cpu.cfs_period_us", buf, sizeof buf)) {
+      if (!sp_limit_number(buf, &p, &end) || end[strspn(end, " \t\r\n")] != 0) p = 0;
+    }
+    if (q && p && (!lim->period || (long double)q / p < (long double)lim->quota / lim->period)) {
+      lim->quota = q; lim->period = p; lim->version = v2 ? 2 : 1;
+    }
+    if ((v2 || strcmp(controller, "memory") == 0) &&
+        sp_limit_read(dir, v2 ? "memory.max" : "memory.limit_in_bytes", buf, sizeof buf) &&
+        sp_limit_number(buf, &q, &end) && q <= SIZE_MAX &&
+        (v2 || q < (unsigned long long)LLONG_MAX / 2) &&
+        (!lim->memory || q < lim->memory)) lim->memory = (size_t)q;
+    if (strlen(dir) <= root_len) break;
+    char *slash = strrchr(dir, '/');
+    if (!slash || (size_t)(slash - dir) < root_len) break;
+    *slash = 0;
+  } while (1);
+}
+#endif
+
+/* Kept separate from the cached accessor so the C regression can supply fake
+   proc/mountinfo files without adding a production environment override. */
+static int sp_resource_detect(const char *cgroup, const char *mountinfo, int online,
+                               int affinity, sp_limits *lim, char *source, size_t cap) {
+#ifdef __linux__
+  sp_cgroup_limits(cgroup, mountinfo, NULL, lim);
+  if (!lim->period) sp_cgroup_limits(cgroup, mountinfo, "cpu", lim);
+  if (!lim->memory) sp_cgroup_limits(cgroup, mountinfo, "memory", lim);
+#else
+  (void)cgroup; (void)mountinfo; (void)lim;
+#endif
+  int n = online > 0 ? online : 1;
+  snprintf(source, cap, "online CPUs");
+  if (affinity > 0 && affinity <= n) { n = affinity; snprintf(source, cap, "sched_getaffinity"); }
+  if (lim->period) {
+    unsigned long long q = lim->quota / lim->period + (lim->quota % lim->period != 0);
+    if (q <= (unsigned)n) {
+      n = (int)q;
+      snprintf(source, cap, "cgroup %s %llu/%llu", lim->version == 2 ? "cpu.max" : "cpu.cfs_quota_us",
+               lim->quota, lim->period);
+    }
+  }
+  return n > 0 ? n : 1;
+}
+
+static int sp_resources_ready, sp_resources_workers, sp_resources_cpu_cap;
+static sp_limits sp_resources_limits;
+static char sp_resources_source[128];
+static void sp_resource_init(void) {
+  if (sp_resources_ready) return;
+  long online = sysconf(_SC_NPROCESSORS_ONLN); int affinity = 0;
+#ifdef __linux__
+  /* A raw bit mask avoids a fixed CPU_SETSIZE limit on large machines. */
+  unsigned long mask[1024] = {0};
+  if (sched_getaffinity(0, sizeof mask, (cpu_set_t *)mask) == 0)
+    for (size_t i = 0; i < sizeof mask / sizeof *mask; i++)
+      for (unsigned long bits = mask[i]; bits; bits &= bits - 1) affinity++;
+#endif
+  sp_resources_cpu_cap = online > INT_MAX ? INT_MAX : online > 0 ? (int)online : 1;
+  if (affinity > 0 && affinity < sp_resources_cpu_cap) sp_resources_cpu_cap = affinity;
+  sp_resources_workers = sp_resource_detect("/proc/self/cgroup", "/proc/self/mountinfo",
+      online > INT_MAX ? INT_MAX : (int)online, affinity, &sp_resources_limits,
+      sp_resources_source, sizeof sp_resources_source);
+  sp_resources_ready = 1;
+}
+static int sp_resource_factor(void) {
+  const char *e = getenv("SPINEL_WORKER_FACTOR");
+  long n = e && *e ? strtol(e, NULL, 10) : 1;
+  return n > 1 && n <= INT_MAX ? (int)n : 1;
+}
+int sp_resource_workers(void) {
+  sp_resource_init();
+  const char *e = getenv("SPINEL_WORKERS");
+  if (e && *e) {
+    long n = strtol(e, NULL, 10);
+    return n > INT_MAX ? INT_MAX : n < 1 ? 1 : (int)n;
+  }
+  int factor = sp_resource_factor();
+  if (factor > 1 && sp_resources_limits.period) {
+    long double budget = (long double)sp_resources_limits.quota * factor / sp_resources_limits.period;
+    if (budget >= sp_resources_cpu_cap) return sp_resources_cpu_cap;
+    int n = (int)budget;
+    return budget > n ? n + 1 : n;
+  }
+  return sp_resources_workers;
+}
+const char *sp_resource_worker_source(void) {
+  sp_resource_init();
+  const char *e = getenv("SPINEL_WORKERS");
+  if (e && *e) return "SPINEL_WORKERS";
+  int factor = sp_resource_factor();
+  if (factor > 1 && strncmp(sp_resources_source, "cgroup ", 7) == 0) {
+    static char source[160];
+    snprintf(source, sizeof source, "%s; factor %d", sp_resources_source, factor);
+    return source;
+  }
+  return sp_resources_source;
+}
+size_t sp_resource_memory_limit(void) { sp_resource_init(); return sp_resources_limits.memory; }
+const char *sp_resource_memory_source(void) {
+  sp_resource_init(); return sp_resources_limits.memory ? "cgroup memory limit" : "unlimited (no visible cgroup limit)";
+}
+/* Each of the object, aggregate young-string, and old-string triggers gets at
+   most 1/8 of the memory limit. This bounds collection pacing, NOT live data,
+   malloc arenas, stacks, or process RSS. The kernel enforces the hard limit. */
+size_t sp_resource_gc_budget(size_t requested, int workers) {
+  size_t memory = sp_resource_memory_limit();
+  if (!memory) return requested;
+  size_t cap = memory / 8 / (size_t)(workers > 0 ? workers : 1);
+  if (!cap) cap = 1;
+  return requested < cap ? requested : cap;
+}
