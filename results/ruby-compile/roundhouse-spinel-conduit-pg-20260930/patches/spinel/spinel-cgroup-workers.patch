diff --git a/test/resource_limits.c b/test/resource_limits.c
new file mode 100644
index 000000000..8f4ad21f7
--- /dev/null
+++ b/test/resource_limits.c
@@ -0,0 +1,88 @@
+/* C-side regression: production parser, fake proc files, no privileged cgroups. */
+#include <assert.h>
+#include <sys/stat.h>
+#include "../lib/sp_resource.c"
+
+static char base[4096], procfile[4096], mountfile[4096], mount[4096];
+static void write_file(const char *path, const char *body) {
+  FILE *f = fopen(path, "w"); assert(f); fputs(body, f); assert(fclose(f) == 0);
+}
+static void limit(const char *suffix, const char *name, const char *body) {
+  char path[8192]; snprintf(path, sizeof path, "%s%s/%s", mount, suffix, name); write_file(path, body);
+}
+static void mounts(const char *root, const char *type, const char *options) {
+  char text[8192];
+  snprintf(text, sizeof text, "1 0 0:1 %s %s rw - %s cgroup %s\n", root, mount, type, options);
+  write_file(mountfile, text);
+}
+static int detect(int online, int affinity, sp_limits *lim, char *source) {
+  memset(lim, 0, sizeof *lim);
+  return sp_resource_detect(procfile, mountfile, online, affinity, lim, source, 128);
+}
+int main(int argc, char **argv) {
+  assert(argc == 2); snprintf(base, sizeof base, "%s", argv[1]);
+  snprintf(procfile, sizeof procfile, "%s/proc", base);
+  snprintf(mountfile, sizeof mountfile, "%s/mountinfo", base);
+  snprintf(mount, sizeof mount, "%s/cgroup", base); assert(mkdir(mount, 0700) == 0);
+  char child[8192]; snprintf(child, sizeof child, "%s/child", mount); assert(mkdir(child, 0700) == 0);
+  sp_limits lim; char source[128];
+#ifdef __linux__
+  mounts("/", "cgroup2", "rw"); write_file(procfile, "0::/child\n");
+  limit("", "cpu.max", "max 100000\n"); limit("/child", "cpu.max", "200000 100000\n");
+  limit("", "memory.max", "max\n"); limit("/child", "memory.max", "1073741824\n");
+  assert(detect(18, 18, &lim, source) == 2); assert(lim.memory == 1073741824);
+  assert(strcmp(source, "cgroup cpu.max 200000/100000") == 0);
+  limit("/child", "cpu.max", "150000 100000\n"); assert(detect(18, 18, &lim, source) == 2);
+  limit("/child", "cpu.max", "50000 100000\n"); assert(detect(18, 18, &lim, source) == 1);
+  limit("/child", "cpu.max", "400000 100000\n"); assert(detect(18, 18, &lim, source) == 4);
+  assert(detect(18, 1, &lim, source) == 1); assert(strcmp(source, "sched_getaffinity") == 0);
+  assert(detect(2, 0, &lim, source) == 2);
+  limit("", "cpu.max", "120000 100000\n"); assert(detect(18, 18, &lim, source) == 2);
+  assert(lim.quota == 120000); /* parent wins, despite child's larger quota */
+  limit("", "memory.max", "536870912\n"); detect(18, 18, &lim, source); assert(lim.memory == 536870912);
+  limit("", "cpu.max", "max 100000\n");
+  const char *invalid[] = {"max 100000\n", "broken\n", "0 100000\n", "100000 0\n", "-1 100000\n",
+    "184467440737095516160 100000\n", "100000 100000junk\n"};
+  for (size_t i = 0; i < sizeof invalid / sizeof *invalid; i++) {
+    limit("/child", "cpu.max", invalid[i]); assert(detect(18, 3, &lim, source) == 3);
+  }
+  limit("/child", "cpu.max", "18446744073709551615 1\n"); assert(detect(18, 18, &lim, source) == 18);
+  /* A subtree bind mount: strip its hierarchy root from the proc path. */
+  mounts("/parent", "cgroup2", "rw"); write_file(procfile, "0::/parent/child\n");
+  limit("/child", "cpu.max", "200000 100000\n"); assert(detect(18, 18, &lim, source) == 2);
+  /* Separate v1 cpu and memory mounts, including cpu,cpuacct token matching. */
+  write_file(procfile, "5:cpu,cpuacct:/child\n6:memory:/child\n");
+  mounts("/", "cgroup", "rw,cpu,cpuacct,memory");
+  limit("", "cpu.cfs_quota_us", "-1\n"); limit("", "cpu.cfs_period_us", "100000\n");
+  limit("/child", "cpu.cfs_quota_us", "150000\n"); limit("/child", "cpu.cfs_period_us", "100000\n");
+  limit("", "memory.limit_in_bytes", "9223372036854771712\n");
+  limit("/child", "memory.limit_in_bytes", "268435456\n");
+  assert(detect(18, 18, &lim, source) == 2); assert(lim.version == 1); assert(lim.memory == 268435456);
+  limit("", "cpu.cfs_quota_us", "50000\n"); assert(detect(18, 18, &lim, source) == 1);
+  mounts("/", "cgroup", "rw,cpuacct"); assert(detect(18, 3, &lim, source) == 3);
+#endif
+  write_file(procfile, ""); write_file(mountfile, "");
+  assert(detect(18, 3, &lim, source) == 3); assert(detect(18, 0, &lim, source) == 18);
+  assert(detect(0, 0, &lim, source) == 1);
+  /* Explicit values retain precedence; an empty value autodetects. */
+  setenv("SPINEL_WORKERS", "7", 1); sp_resources_ready = 0;
+  assert(sp_resource_workers() == 7); assert(strcmp(sp_resource_worker_source(), "SPINEL_WORKERS") == 0);
+  setenv("SPINEL_WORKERS", "0", 1); sp_resources_ready = 0; assert(sp_resource_workers() == 1);
+  setenv("SPINEL_WORKERS", "", 1); sp_resources_ready = 0; assert(sp_resource_workers() >= 1);
+  assert(strcmp(sp_resource_worker_source(), "SPINEL_WORKERS") != 0);
+  /* Scaling rounds the quota AFTER multiplication: 1.5 CPUs * 2 = 3. */
+  sp_resources_ready = 1; sp_resources_cpu_cap = 18; sp_resources_workers = 2;
+  sp_resources_limits.quota = 150000; sp_resources_limits.period = 100000;
+  setenv("SPINEL_WORKER_FACTOR", "2", 1); assert(sp_resource_workers() == 3);
+  sp_resources_cpu_cap = 2; assert(sp_resource_workers() == 2);
+  setenv("SPINEL_WORKERS", "7", 1); assert(sp_resource_workers() == 7);
+  setenv("SPINEL_WORKERS", "", 1); setenv("SPINEL_WORKER_FACTOR", "1", 1);
+  assert(sp_resource_workers() == 2);
+  sp_resources_limits.period = 0;
+  sp_resources_limits.memory = 1073741824; sp_resources_ready = 1;
+  assert(sp_resource_gc_budget(SIZE_MAX, 1) == 134217728);
+  assert(sp_resource_gc_budget(SIZE_MAX, 2) == 67108864);
+  assert(sp_resource_gc_budget(2048, 2) == 2048);
+  sp_resources_limits.memory = 0; assert(sp_resource_gc_budget(SIZE_MAX, 1) == SIZE_MAX);
+  puts("resource-test: pass"); return 0;
+}
