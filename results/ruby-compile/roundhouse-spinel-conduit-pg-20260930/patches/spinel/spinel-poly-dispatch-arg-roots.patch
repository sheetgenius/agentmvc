diff --git a/test/poly_dispatch_arg_gc_root.rb b/test/poly_dispatch_arg_gc_root.rb
new file mode 100644
index 000000000..a3336f801
--- /dev/null
+++ b/test/poly_dispatch_arg_gc_root.rb
@@ -0,0 +1,74 @@
+# A call on a boxed receiver dispatches on its runtime class, and the
+# arguments are evaluated into temps first, left to right, before the arm
+# for the class is chosen. Each temp must be rooted: a fresh value held by
+# nothing but its temp (`tags.uniq`, a boxed Time) was collected while a
+# later argument allocated, or while the arm allocated the keyword hash it
+# stores the values into, and the callee then read a freed slot -- a
+# string array whose slot another array had taken (SIGSEGV in
+# sp_str_length), or a Time read back as some year 8920956.
+#
+# The `(Time.at(...) if st == "published")` operand is a no-else `if`
+# written as a statement ahead of the call: its result temp must be
+# rooted too, as the receiver and every operand to its right run before
+# the call.
+#
+# `mark` runs GC.start and then reuses the freed slots; the receiver
+# (`source`) and the last argument call it, after the values before them
+# are held only by their temps.
+
+class Bag
+  def merge(other)
+    other
+  end
+end
+
+# returns a Hash or a Bag, so `.merge` below dispatches on a boxed receiver
+def source(k)
+  return Bag.new if k < 0
+  { title: mark("t#{k}") }
+end
+
+def mark(s)
+  GC.start
+  # reuse what the collection freed, so a dangling temp reads other bytes
+  junk = []
+  64.times { |k| junk << ["j#{k}", "k#{k}", "l#{k}"]; junk << Time.at(k) }
+  s + "-" + junk.size.to_s
+end
+
+def fresh_tags(i)
+  ["a#{i}", "b#{i}", "a#{i}"]
+end
+
+3.times do |i|
+  st = i >= 0 ? "published" : "draft"
+  h = source(i).merge(at: (Time.at(1_700_000_000 + i) if st == "published"),
+                      tags: fresh_tags(i).uniq,
+                      slug: mark("s#{i}"))
+  GC.start
+  puts h[:title]
+  puts h[:at].to_i
+  puts h[:tags].map { |t| t.upcase }.join(",")
+  puts h[:slug]
+end
+
+# the same through positional arguments of a user method on a boxed receiver
+class Pair
+  def initialize(a, b); @a = a; @b = b; end
+  def put(a, b); [a, b]; end
+end
+
+class Twin
+  def put(a, b); [b, a]; end
+end
+
+def pick(k)
+  k > 5 ? Twin.new : Pair.new(1, 2)
+end
+
+2.times do |i|
+  r = pick(i).put(fresh_tags(i).uniq, mark("p#{i}"))
+  GC.start
+  puts r[0].join("+")
+  puts r[1]
+end
