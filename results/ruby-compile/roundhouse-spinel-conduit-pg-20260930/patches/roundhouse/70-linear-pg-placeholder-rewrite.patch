+++ b/tests/db_pg_placeholders.rb
@@ -0,0 +1,30 @@
+# Evaluated after the actual Db.rewrite_placeholders method has been extracted.
+# No libpq connection is needed to exercise this lexical rewrite.
+cases = [
+  ["SELECT ?", "SELECT $1"],
+  ["SELECT ?, ?", "SELECT $1, $2"],
+  ["SELECT '?' AS x, ?", "SELECT '?' AS x, $1"],
+  ["SELECT 'it''s ?' AS x, ?", "SELECT 'it''s ?' AS x, $1"],
+  [%q{SELECT "a""?b", ?}, %q{SELECT "a""?b", $1}],
+  [%q{SELECT E'it\'s ? \\ ?', ?}, %q{SELECT E'it\'s ? \\ ?', $1}],
+  ["SELECT ? -- ?\n, ?", "SELECT $1 -- ?\n, $2"],
+  ["SELECT /* ? /* ? */ ? */ ?", "SELECT /* ? /* ? */ ? */ $1"],
+  ['SELECT $$?$$, ?', 'SELECT $$?$$, $1'],
+  ['SELECT $tag_9$?$tag_9$, ?', 'SELECT $tag_9$?$tag_9$, $1'],
+  ['SELECT $9$, ?', 'SELECT $9$, $1'],
+  ['SELECT $1, ?', 'SELECT $1, $1'],
+  ["SELECT 'héllo 😀 ?', ? AS 世界", "SELECT 'héllo 😀 ?', $1 AS 世界"],
+  ["SELECT -- 世界 ?\n ?", "SELECT -- 世界 ?\n $1"],
+  ["", ""],
+  ["SELECT '" + "界" * 10000 + "?', ?", "SELECT '" + "界" * 10000 + "?', $1"],
+]
+cases.each_with_index do |pair, i|
+  sql = pair[0]
+  expected = pair[1]
+  got = Db.rewrite_placeholders(sql)
+  raise "case #{i}: mismatch" unless got == expected
+end
+sql = "SELECT ?, '?', ? /* ? */"
+raise "literal interpolation" unless Db.rewrite_placeholders(sql, ["'héllo'", "NULL"]) == "SELECT 'héllo', '?', NULL /* ? */"
+raise "input mutated" unless sql == "SELECT ?, '?', ? /* ? */"
+puts "PASS 18 placeholder checks"
diff --git a/tests/db_pg_placeholders.rs b/tests/db_pg_placeholders.rs
new file mode 100644
index 00000000..cbb302aa
--- /dev/null
+++ b/tests/db_pg_placeholders.rs
@@ -0,0 +1,17 @@
+//! Test the actual PostgreSQL SQL rewriter without loading the FFI adapter.
+use std::process::Command;
+
+#[test]
+fn postgres_placeholders_preserve_sql_literals_comments_and_utf8() {
+    let source = include_str!("../runtime/spinel/db_pg.rb");
+    let start = source.find("  def self.rewrite_placeholders(").unwrap();
+    let end = source[start..].find("  def self.interpolate(").unwrap() + start;
+    let script = format!(
+        "module Db\n{}end\n{}",
+        &source[start..end],
+        include_str!("db_pg_placeholders.rb")
+    );
+    let output = Command::new("ruby").arg("-e").arg(script).output().expect("ruby");
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    assert_eq!(String::from_utf8_lossy(&output.stdout).trim(), "PASS 18 placeholder checks");
+}
