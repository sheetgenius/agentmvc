diff --git a/runtime/spinel/db_pg.rb b/runtime/spinel/db_pg.rb
index 99846618..20398eb3 100644
--- a/runtime/spinel/db_pg.rb
+++ b/runtime/spinel/db_pg.rb
@@ -207,6 +207,12 @@ module Db
   @prepare_lock = Mutex.new
 
   def self.configure(conninfo, pool_size: 8)
+    # libpq calls block OS workers. Use twice the cgroup CPU quota, rounded
+    # after scaling, to overlap DB waits; never a deployment-specific count.
+    # SPINEL_WORKERS still wins; SPINEL_WORKER_FACTOR=1 opts out. With no quota
+    # Spinel keeps the affinity/online CPU bound. Set before the first Thread.
+    factor = ENV["SPINEL_WORKER_FACTOR"]
+    ENV["SPINEL_WORKER_FACTOR"] = "2" if factor.nil? || factor.empty?
     close
     n = pool_size
     ev = ENV["DATABASE_POOL_SIZE"]
