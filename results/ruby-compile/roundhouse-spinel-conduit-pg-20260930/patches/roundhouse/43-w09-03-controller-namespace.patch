+#[cfg(test)]
+mod compile_blocker_tests {
+    use super::*;
+
+    #[test]
+    fn compile_blocker_nested_exception_reopens_controller_as_class() {
+        let source = b"class ApplicationController\n  class Failure < StandardError\n  end\nend\n";
+        let mut app = App::new();
+        app.library_classes = crate::ingest::ingest_library_classes(source, "failure.rb").unwrap()
+            .into_iter().filter(|c| c.name.0.as_str().ends_with("::Failure")).collect();
+        app.controllers.push(crate::dialect::Controller {
+            name: ClassId(Symbol::from("ApplicationController")),
+            parent: Some(ClassId(Symbol::from("ActionController::API"))),
+            body: vec![], layout: Default::default(), sibling_classes: vec![],
+        });
+        let files = emit_library_class_decls(&app);
+        let failure = files.iter().find(|f| f.path.ends_with("failure.rb")).unwrap();
+        assert!(failure.content.contains("class ApplicationController < ActionController::API"),
+            "{}", failure.content);
+        assert!(!failure.content.contains("module ApplicationController"));
+        assert_eq!(ruby_prism::parse(failure.content.as_bytes()).errors().count(), 0);
+    }
+}
