@@ -1299,6 +1314,32 @@ mod tests {
     use crate::ident::Symbol;
     use crate::span::Span;
 
+    #[test]
+    fn compile_blocker_raise_boolean_operand_parses() {
+        let expr = Expr::new(Span::default(), ExprNode::BoolOp {
+            op: crate::expr::BoolOpKind::Or,
+            surface: crate::expr::BoolOpSurface::Symbol,
+            left: lit_sym("found"),
+            right: Expr::new(Span::default(), ExprNode::Raise { value: lit_str("missing") }),
+        });
+        let emitted = emit_expr(&expr);
+        let parsed = ruby_prism::parse(emitted.as_bytes());
+        assert_eq!(parsed.errors().count(), 0, "{emitted}");
+    }
+
+    #[test]
+    fn compile_blocker_parenthesized_command_boolean_operand_parses() {
+        let source = b"user || (raise ApplicationController::Failure.new(404, :profile, \"not found\"))";
+        let parsed = ruby_prism::parse(source);
+        let root = parsed.node();
+        let statements = root.as_program_node().unwrap().statements();
+        let node = statements.body().iter().next().unwrap();
+        let expr = crate::ingest::ingest_expr(&node, "profile.rb").unwrap();
+        let emitted = emit_expr(&expr);
+        assert_eq!(ruby_prism::parse(emitted.as_bytes()).errors().count(), 0, "{emitted}");
+        assert!(emitted.contains("(raise ApplicationController::Failure.new"), "{emitted}");
+    }
+
     fn lit_sym(s: &str) -> Expr {
         Expr::new(Span::default(), ExprNode::Lit { value: Literal::Sym { value: Symbol::from(s) } })
     }
