      "changes": 15,
      "blob_url": "https://github.com/matz/spinel/blob/b570999724ea9249fb91654bcef704fc9e20fdbc/test%2Fobject_body_builder_class_name.rb",
      "raw_url": "https://github.com/matz/spinel/raw/b570999724ea9249fb91654bcef704fc9e20fdbc/test%2Fobject_body_builder_class_name.rb",
      "contents_url": "https://api.github.com/repos/matz/spinel/contents/test%2Fobject_body_builder_class_name.rb?ref=b570999724ea9249fb91654bcef704fc9e20fdbc",
      "patch": "@@ -0,0 +1,15 @@\n+# A class, Struct or module a reopened Object's body makes is a top-level\n+# constant's: CRuby names it without Object:: before it, as a module's own\n+# takes the module's name.\n+class Object\n+  B = Class.new\n+  S = Struct.new(:a)\n+  M2 = Module.new\n+  class Inner; end\n+end\n+module N\n+  B2 = Class.new\n+end\n+p B, S, M2, Inner, N::B2\n+p [B.name, S.name, M2.name, N::B2.name]\n+p S.new(1)"
    },
