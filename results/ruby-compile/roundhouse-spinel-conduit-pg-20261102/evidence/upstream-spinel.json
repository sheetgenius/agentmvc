      "blob_url": "https://github.com/matz/spinel/blob/b570999724ea9249fb91654bcef704fc9e20fdbc/test%2Fobject_body_builder_class_name.rb.expected",
      "raw_url": "https://github.com/matz/spinel/raw/b570999724ea9249fb91654bcef704fc9e20fdbc/test%2Fobject_body_builder_class_name.rb.expected",
