+++ b/tests/spinel_raw_websocket.rs
@@ -0,0 +1,17 @@
+//! Source-level lifecycle regressions for the Spinel transport. The native
+//! integration fixture also drives real upgrades, callbacks and room broadcasts.
+use std::path::Path;
+use std::process::Command;
+
+#[test]
+fn raw_websocket_closes_wake_and_retire_the_connection() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"));
+    let out = Command::new("ruby")
+        .arg(root.join("tests/spinel_raw_websocket.rb"))
+        .arg(root)
+        .output()
+        .expect("ruby is on PATH");
+    assert!(out.status.success(), "stdout:\n{}\nstderr:\n{}",
+        String::from_utf8_lossy(&out.stdout), String::from_utf8_lossy(&out.stderr));
+    assert!(String::from_utf8_lossy(&out.stdout).contains("ALL OK"));
+}
