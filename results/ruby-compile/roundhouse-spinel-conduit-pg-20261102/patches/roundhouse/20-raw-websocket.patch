diff --git a/tests/spinel_raw_websocket.rb b/tests/spinel_raw_websocket.rb
new file mode 100644
index 000000000..9f622b6a5
--- /dev/null
+++ b/tests/spinel_raw_websocket.rb
@@ -0,0 +1,146 @@
+require "socket"
+require "io/wait"
+require "digest"
+require "base64"
+require "timeout"
+ROOT = File.expand_path(ARGV.fetch(0))
+
+# Test-only POSIX and DB bindings. All framing/lifecycle/facade code is real.
+module Sock
+  def self.sphttp_write_bytes(fd, bytes, n)
+    IO.for_fd(fd, autoclose: false).syswrite(bytes.byteslice(0, n))
+  end
+  def self.sp_net_recv_some(fd, n)
+    IO.for_fd(fd, autoclose: false).readpartial(n)
+  rescue EOFError
+    ""
+  end
+end
+module TepSocketControl
+  CALLS = []
+  def self.shutdown(fd, how)
+    CALLS << fd
+    socket = Socket.for_fd(fd)
+    socket.autoclose = false
+    socket.shutdown(how)
+    0
+  end
+end
+module Crypto
+  def self.sp_crypto_websocket_accept(key)
+    Base64.strict_encode64(Digest::SHA1.digest(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
+  end
+end
+module Db
+  LEASES = []
+  def self.with_connection
+    LEASES << Thread.current
+    yield
+  end
+end
+module Tep
+  def self.str_find(s, sub, offset); s.index(sub, offset) || -1; end
+  class Request
+    attr_accessor :verb, :req_headers
+    def initialize
+      @verb = ""
+      @req_headers = Hash.new("")
+    end
+  end
+  module Broadcast
+    CLOSED = []
+    def self.unsubscribe_fd(fd); CLOSED << fd; end
+  end
+  module Presence
+    CLOSED = []
+    def self.untrack_by_fd(fd); CLOSED << fd; end
+  end
+end
+require File.join(ROOT, "runtime/spinel/tep/websocket")
+require File.join(ROOT, "runtime/spinel/faye_websocket")
+
+def check(value, label)
+  raise label unless value
+end
+class Recorder < Tep::WebSocket::Handler
+  attr_reader :events
+  def initialize; @events = []; end
+  def handle_event(event); @events << event; end
+end
+
+# A close requested by another thread must wake a parked recv, send one
+# close, run one callback and refuse every subsequent write/shutdown.
+owner, peer = Socket.pair(:UNIX, :STREAM, 0)
+driver = Tep::WebSocket::Driver.new(owner.fileno)
+recorder = Recorder.new
+driver.set_on_close(recorder)
+connection = Tep::WebSocket::Connection.new(driver, owner)
+runner = Thread.new { connection.run }
+sleep 0.03
+driver.close(1000, "test")
+check(peer.readpartial(100).getbyte(0) == 0x88, "missing close frame")
+peer.write([0x88, 0x82, 0, 0, 0, 0, 3, 232].pack("C*"))
+Timeout.timeout(1) { runner.join }
+check(recorder.events.size == 1, "close callback repeated/missing")
+check(driver.text("too late") == -1, "write after close")
+shutdowns = TepSocketControl::CALLS.size
+driver.close(1000, "again")
+check(TepSocketControl::CALLS.size == shutdowns, "shutdown after retirement")
+owner.close; peer.close
+
+# An open-time close whose bounded deadline expired must not enter wait_readable.
+class ClosingOpen < Tep::WebSocket::Handler
+  def initialize(driver); @driver = driver; end
+  def handle_event(event); @driver.close(1000, ""); @driver.expire_close; end
+end
+class NoRead
+  def wait_readable(_); raise "recv after open-time close"; end
+end
+driver = Tep::WebSocket::Driver.new(-1)
+recorder = Recorder.new
+driver.set_on_open(ClosingOpen.new(driver))
+driver.set_on_close(recorder)
+Tep::WebSocket::Connection.new(driver, NoRead.new).run
+check(recorder.events.size == 1, "open-time close callback")
+
+# A received close ends the recv loop, rather than waiting for another frame.
+owner, peer = Socket.pair(:UNIX, :STREAM, 0)
+driver = Tep::WebSocket::Driver.new(owner.fileno)
+recorder = Recorder.new
+driver.set_on_close(recorder)
+runner = Thread.new { Tep::WebSocket::Connection.new(driver, owner).run }
+peer.write([0x88, 0x82, 0, 0, 0, 0, 3, 232].pack("C*"))
+Timeout.timeout(1) { runner.join }
+check(recorder.events.size == 1, "received close callback")
+owner.close; peer.close
+
+# Handler failures still retire and release the transport registries.
+class FailingOpen < Tep::WebSocket::Handler
+  def handle_event(_); raise "handler failed"; end
+end
+driver = Tep::WebSocket::Driver.new(-1)
+driver.set_on_open(FailingOpen.new)
+begin
+  Tep::WebSocket::Connection.new(driver, NoRead.new).run
+rescue RuntimeError => e
+  check(e.message == "handler failed", "wrong exception")
+end
+check(driver.text("late") == -1, "exception did not retire")
+check(Tep::Broadcast::CLOSED.last == -1 && Tep::Presence::CLOSED.last == -1, "exception did not clean up")
+
+# Faye-shaped callback closures, the request's upgrade marker and DB leases.
+env = {"REQUEST_METHOD" => "GET", "HTTP_UPGRADE" => "websocket",
+       "HTTP_CONNECTION" => "Upgrade", "HTTP_SEC_WEBSOCKET_VERSION" => "13",
+       "HTTP_SEC_WEBSOCKET_KEY" => "dGhlIHNhbXBsZSBub25jZQ=="}
+check(Faye::WebSocket.websocket?(env), "Faye handshake")
+check(!Faye::WebSocket.websocket?({}), "non-WebSocket accepted")
+socket = Faye::WebSocket.new(env, nil, ping: 0)
+messages = []
+socket.on(:message) { |event| messages << event.data }
+Tep::WebSocket::Connection.dispatch_message(socket.driver, "raw JSON", true)
+check(messages == ["raw JSON"] && !Db::LEASES.empty?, "callback/DB lease")
+check(socket.rack_response[0] == -1 && env["roundhouse.websocket"].equal?(socket), "upgrade marker")
+ran = false
+EventMachine.schedule { ran = true }
+check(ran, "schedule did not run")
+puts "ALL OK raw WebSocket lifecycle and Faye callbacks"
diff --git a/tests/spinel_raw_websocket.rs b/tests/spinel_raw_websocket.rs
