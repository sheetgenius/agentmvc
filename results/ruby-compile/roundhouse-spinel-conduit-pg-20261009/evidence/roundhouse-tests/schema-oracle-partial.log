ROUNDHOUSE_POSTGRES_GENERATED_INT4_DDL_BEGIN
CREATE TABLE IF NOT EXISTS "counters" (
  "id" bigserial PRIMARY KEY,
  "payload_json" json,
  "payload_jsonb" jsonb,
  "counter_text" text,
  "label" character varying,
  "case_name" character varying NOT NULL,
  "from_json" integer GENERATED ALWAYS AS ((payload_json ->> 'counter'::text)::integer) STORED,
  "from_jsonb" integer GENERATED ALWAYS AS (CAST((payload_jsonb ->> 'counter'::text) AS int4)) STORED,
  "from_text" integer GENERATED ALWAYS AS (counter_text::integer) STORED
);
CREATE TABLE IF NOT EXISTS "required_counters" (
  "id" bigserial PRIMARY KEY,
  "payload_jsonb" jsonb,
  "required_count" integer GENERATED ALWAYS AS ((payload_jsonb ->> 'counter'::text)::integer) STORED NOT NULL
