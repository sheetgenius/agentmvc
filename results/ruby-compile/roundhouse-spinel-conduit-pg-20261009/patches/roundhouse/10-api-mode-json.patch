diff --git a/tests/api_mode.rs b/tests/api_mode.rs
new file mode 100644
index 00000000..ea37678b
--- /dev/null
+++ b/tests/api_mode.rs
@@ -0,0 +1,55 @@
+//! Viewless API controllers use the same lowering in actions, callbacks,
+//! and inherited rescue handlers. Native HTTP coverage lives in the w06 probe.
+use std::collections::HashMap;
+use std::path::PathBuf;
+use roundhouse::ingest::ingest_app_from_tree;
+
+fn files() -> Vec<roundhouse::emit::EmittedFile> {
+    let source: HashMap<PathBuf, Vec<u8>> = [
+        ("app/controllers/application_controller.rb", r#"class ApplicationController < ActionController::API
+  rescue_from StandardError do |failure|
+    render json: { errors: [failure.message] }, status: 422
+  end
+  after_action { response.set_header("X-Probe", "yes") }
+end"#),
+        ("app/controllers/posts_controller.rb", r#"class PostsController < ApplicationController
+  rescue_from StandardError do |failure|
+    render json: { errors: [failure.message] }, status: 409
+  end
+  def show
+    render json: { title: params[:post][:title], limit: params.fetch(:limit, 20), hasLimit: params.key?(:limit) }
+  end
+end"#),
+        ("config/routes.rb", r#"Rails.application.routes.draw do
+  scope :api do
+    get "posts/:slug", to: "posts#show"
+  end
+  match "*unmatched", to: "application#not_found", via: :all
+end"#),
+    ].into_iter().map(|(p,s)| (PathBuf::from(p), s.as_bytes().to_vec())).collect();
+    let mut app = ingest_app_from_tree(source).expect("ingest");
+    roundhouse::session::analyze_and_lower(&mut app);
+    roundhouse::emit::ruby::emit_spinel(&app)
+}
+
+#[test]
+fn json_handlers_and_nested_params_are_lowered() {
+    let emitted = files();
+    let controller = &emitted.iter().find(|f| f.path.ends_with("posts_controller.rb")).unwrap().content;
+    assert!(controller.contains("@params[\"post\"][\"title\"]"), "{controller}");
+    assert!(controller.contains("@params.fetch(\"limit\", 20)"), "{controller}");
+    assert!(controller.contains("@params.key?(\"limit\")"), "{controller}");
+    assert!(controller.contains("render(ActionController::JsonRender.encode({ errors:"), "{controller}");
+    assert!(controller.contains("response.set_header(\"X-Probe\", \"yes\")"), "{controller}");
+    let dispatch = controller.split("def process_action").nth(1).expect("dispatcher");
+    assert!(dispatch.find("status: :conflict").unwrap_or_else(|| panic!("{dispatch}")) < dispatch.find("status: :unprocessable_entity").unwrap_or_else(|| panic!("{dispatch}")), "subclass handler wins: {dispatch}");
+}
+
+#[test]
+fn dispatch_has_a_complete_table_without_a_root() {
+    let emitted = files();
+    let routes = &emitted.iter().find(|f| f.path.ends_with("routes.rb")).unwrap().content;
+    assert!(routes.contains("def self.table"), "{routes}");
+    assert!(!routes.contains("def self.root"), "{routes}");
+    assert!(routes.contains("\"ANY\", \"/*unmatched\""), "{routes}");
+}
