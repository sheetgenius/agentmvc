+/// Install the selected backend before spin reshapes tests and writes requires.
+fn postgresql_files(mut files: Vec<(String, String)>, fixture: &Path) -> Result<Vec<(String, String)>, String> {
+    if !crate::postgresql_enabled() { return Ok(files); }
+    let ddl = std::fs::read_to_string(fixture.join("db/structure.sql"))
+        .map_err(|e| format!("PostgreSQL requires db/structure.sql: {e}"))?;
+    for (path, content) in &mut files {
+        if path == "runtime/db.rb" {
+            *content = crate::runtime_files::read_to_string("runtime/spinel/db_libpq.rb")?;
+        } else if path == "main.rb" {
+            *content = content.replace("path = Main.default_db_path", "path = ENV.fetch(\"DATABASE_URL\")")
+                .replace("Schema.statements.each { |sql| SqliteAdapter.execute_ddl(sql) }", "Db.prepare_schema(\"db/structure.sql\")");
+        } else if path == "test/test_helper.rb" {
+            *content = content.replace("Db.configure(_test_db_path)", "Db.configure(ENV.fetch(\"DATABASE_URL\"))")
+                .replace("Schema.statements.each { |sql| Db.exec(sql) }", "Db.prepare_schema(\"db/structure.sql\")");
+        } else if path == "runtime/active_record/connection.rb" {
+            let start = content.find("    def self.transaction").ok_or("transaction anchor moved")?;
+            let end = content[start..].find("\n    # `Model.update_counters").ok_or("transaction end moved")? + start;
+            content.replace_range(start..end, "    def self.transaction(isolation: nil, requires_new: nil, joinable: true)\n      tx = Db.transaction_begin\n      commit = false\n      begin\n        result = yield\n        commit = true\n      ensure\n        Db.transaction_end(tx, commit)\n      end\n      result\n    end\n");
+            *content = content.replace("\"SQLite\"", "\"PostgreSQL\"")
+                .replace("        \"1\"", "        \"TRUE\"")
+                .replace("        \"0\"", "        \"FALSE\"");
+        } else if path == "runtime/active_record/base.rb" {
+            let start = content.find("    def with_lock(").ok_or("with_lock anchor moved")?;
+            let end = content[start..].find("    def _adapter_reload_lock\n").ok_or("with_lock end moved")? + start;
+            content.replace_range(start..end, "    def with_lock(*args)\n      raise \"Locking a record with unsaved changes is not supported\" if persisted? && !changes_to_save.empty?\n      tx = Db.transaction_begin\n      commit = false\n      begin\n        reload(lock: true)\n        result = yield\n        commit = true\n      ensure\n        Db.transaction_end(tx, commit)\n      end\n      result\n    end\n\n");
+        } else if path == "runtime/active_support_ext.rb" {
+            *content = content.replace("zone.nil? ? t.getlocal : t.getlocal(zone.offset_at(t.to_i))", "if zone.nil?\n      ENV.fetch(\"TZ\", \"UTC\") == \"UTC\" ? t.getutc : t.getlocal\n    elsif zone.name == \"UTC\" || zone.name == \"Etc/UTC\"\n      t.getutc\n    else\n      t.getlocal(zone.offset_at(t.to_i))\n    end");
+        } else if path == "runtime/active_record/relation.rb" {
+            let start = content.find("    def substitute_binds(sql, args)\n").ok_or("bind anchor moved")?;
+            let end = content[start..].find("\n    def escape_list").ok_or("bind end moved")? + start;
+            content.replace_range(start..end, "    def substitute_binds(sql, args)\n      Db.interpolate(sql, args.map { |a| ActiveRecord.adapter.escape_value(a) })\n    end\n");
+            *content = content.replace("qcol = col.include?(\".\") ? col : \"#{@table}.#{col}\"", "qcol = col.include?(\".\") ? col.split(\".\").map { |part| Db.quote_identifier(part) }.join(\".\") : @table + \".\" + Db.quote_identifier(col)");
+        } else if path == "runtime/sqlite_adapter.rb" {
+            *content = content.replace("      \"1\"", "      \"TRUE\"").replace("      \"0\"", "      \"FALSE\"")
