+
+// A non-local early return and an unknown tail must keep the tail's
+// gradual arm through later harvest rounds. Symbol? would tell the
+// compiled consumer to unbox an arbitrary room object as a Symbol.
+#[test]
+fn a_block_return_does_not_erase_an_unknown_room_tail() {
+    let rbs = sidecars(r#"
+class Rooms
+  Room = Struct.new(:lock, :members)
+
+  def self.room(id)
+    state = Rails.application.room_state
+    state[:lock].synchronize { state[:rooms][id] ||= Room.new(Mutex.new, {}) }
+  end
+
+  def self.join(id, socket)
+    room = room(id)
+    room.lock.synchronize do
+      return if socket.closed?
+      return :full if room.members.length >= 100
+      broadcast(room)
+    end
+    room
+  end
+
+  def self.broadcast(room)
+    room.members.each_key { |socket| socket.send("presence") }
+  end
+
+  def self.open(id, socket)
+    result = join(id, socket)
+    return if result == :full
+    broadcast(result)
+  end
+end
+"#);
+    let join = rbs.lines().find(|line| line.contains("def self.join:")).expect("join signature");
+    assert!(join.ends_with("-> untyped"), "{rbs}");
+    let broadcast = rbs.lines().find(|line| line.contains("def self.broadcast:")).expect("broadcast signature");
+    assert!(!broadcast.contains("Symbol room"), "{rbs}");
+}
