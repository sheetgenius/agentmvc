index 00000000..967d3685
--- /dev/null
+++ b/tests/boot_hooks.rs
@@ -0,0 +1,111 @@
+//! after_initialize must run as lowered app code, and only in server main.
+use roundhouse::project::{BuildTarget, target_files};
+use std::collections::HashMap;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+fn app(initializer: &str) -> Result<roundhouse::App, roundhouse::ingest::IngestError> {
+    let files = [
+        (
+            "config/application.rb",
+            "module BootFixture\n class Application < Rails::Application\n config.after_initialize { BootProbe.mark(1) }\n end\nend\n",
+        ),
+        ("config/initializers/a.rb", initializer),
+        (
+            "app/models/application_record.rb",
+            "class ApplicationRecord < ActiveRecord::Base\nend\n",
+        ),
+        (
+            "app/controllers/application_controller.rb",
+            "class ApplicationController < ActionController::Base\nend\n",
+        ),
+        (
+            "app/controllers/probes_controller.rb",
+            "class ProbesController < ApplicationController\n def index\n render \"ok\"\n end\nend\n",
+        ),
+        (
+            "app/services/boot_probe.rb",
+            "class BootProbe\n def self.mark(value)\n value\n end\nend\n",
+        ),
+        (
+            "config/routes.rb",
+            "Rails.application.routes.draw { root \"probes#index\" }\n",
+        ),
+        ("db/schema.rb", "ActiveRecord::Schema.define {}\n"),
+    ];
+    let tree: HashMap<PathBuf, Vec<u8>> = files
+        .into_iter()
+        .map(|(p, s)| (p.into(), s.as_bytes().to_vec()))
+        .collect();
+    roundhouse::ingest::ingest_app_from_tree(tree)
+}
+
+#[test]
+fn boot_hooks_emit_and_run_in_registration_order() {
+    let mut app = app("if defined?(Rails::Server)\n Rails.application.config.after_initialize { BootProbe.mark(2) }\nend\nRails.application.configure do\n config.after_initialize { BootProbe.mark(3) }\nend\n").unwrap();
+    let diags = roundhouse::session::analyze_and_lower(&mut app);
+    assert!(
+        !diags
+            .iter()
+            .any(|d| d.severity == roundhouse::diagnostic::Severity::Error),
+        "{diags:?}"
+    );
+    let files = target_files(&app, Path::new("."), BuildTarget::Spinel).unwrap();
+    let config = &files
+        .iter()
+        .find(|(p, _)| p == "config/application.rb")
+        .unwrap()
+        .1;
+    let main = &files.iter().find(|(p, _)| p == "main.rb").unwrap().1;
+    let setup = main.rfind("Main.configure_default_adapter!").unwrap();
+    let register = main.rfind("ActiveJob.register_drain").unwrap();
+    let hooks = main
+        .find("Db.with_connection { Rails.application.run_after_initialize }")
+        .unwrap();
+    let thread = main[hooks..].find("Thread.new").unwrap() + hooks;
+    let listener = main.rfind("Tep::Server::Threaded.new").unwrap();
+    assert!(setup < register && register < hooks && hooks < thread && thread < listener);
+    assert_eq!(
+        main.matches("Rails.application.run_after_initialize")
+            .count(),
+        1
+    );
+    let boot = &files.iter().find(|(p, _)| p == "boot.rb").unwrap().1;
+    assert!(!boot.contains("run_after_initialize")); // requiring the app never runs hooks
+    let script = format!(
+        "module Rails; end\nclass BootProbe\n LOG = []\n def self.mark(value); LOG << value; end\nend\n{config}\nraise 'ran at require' unless BootProbe::LOG.empty?\nRails::Application.new.run_after_initialize\nraise BootProbe::LOG.inspect unless BootProbe::LOG == [1, 2, 3]\n"
+    );
+    let mut child = Command::new("ruby")
+        .arg("-")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(script.as_bytes())
+        .unwrap();
+    let output = child.wait_with_output().unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+#[test]
+fn boot_hooks_reject_unlowered_registration_forms() {
+    for source in [
+        "Rails.application.config.after_initialize { |app| app.recover! }",
+        "Rails.application.config.after_initialize :recover!",
+        "if ENV['RECOVER']\n Rails.application.config.after_initialize { BootProbe.mark(2) }\nend",
+        "if defined?(Rails::Server)\n nil\nelse\n Rails.application.config.after_initialize { BootProbe.mark(2) }\nend",
+        "unless ENV['SKIP']\n Rails.application.config.after_initialize { BootProbe.mark(2) }\nend",
+    ] {
+        assert!(app(source).is_err(), "silently dropped: {source}");
+    }
+}
