diff --git avariant/app/services/json_cast.rb bvariant/app/services/json_cast.rb
new file mode 100644
index 0000000..3abbece
--- /dev/null
+++ bvariant/app/services/json_cast.rb
@@ -0,0 +1,9 @@
+# Compile variant: Active Model's string cast for typed JSON values (Rails applies it on assignment).
+class JsonCast
+  def self.string(value)
+    return nil if value.nil?
+    return "t" if value == true
+    return "f" if value == false
+    value.is_a?(String) ? value : value.to_s
+  end
+end
