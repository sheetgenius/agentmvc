+  def self.capture_sql
+    prev = @query_log
+    log = []
+    @query_log = log
+    begin
+      yield
+    ensure
+      @query_log = prev
+    end
+    log
+  end
+  def self.record_query(sql)
+    @query_log.push(sql) if !@query_log.nil?
