+  end
+  def self.sql_trace?
+    ENV.fetch("RH_SQL_TRACE", "") != ""
+  end
+  def self.check_result(conn, r)
+    raise "libpq returned NULL" if r.nil?
+    status = PG.PQresultStatus(r)
+    if status != PG::COMMAND_OK && status != PG::TUPLES_OK
+      code = PG.PQresultErrorField(r, PG::SQLSTATE)
+      message = PG.PQresultErrorMessage(r)
+      conn.set_sqlstate(code.nil? ? "" : code)
+      PG.PQclear(r)
+      raise ActiveRecord::RecordNotUnique, "SQLSTATE " + conn.sqlstate + ": " + message if conn.sqlstate == "23505"
+      raise "SQLSTATE " + conn.sqlstate + ": " + message
+    end
+    conn.set_sqlstate("")
+    nil
+  end
+  def self.last_error_sqlstate
+    current_conn.sqlstate
+  end
+  def self.unique_violation?(message)
+    message.include?("23505")
+  end
+  def self.exec(sql)
+    record_query(sql)
+    c = current_conn
+    r = PG.PQexec(c.dbh, sql)
+    check_result(c, r)
+    c.set_changes(PG.PQcmdTuples(r).to_i)
+    PG.PQclear(r)
+    nil
+  end
+
+  # Rewrite anonymous binds outside SQL literals, quoted identifiers, dollar
+  # strings and comments. E'...' backslash escapes and nested /* */ are handled.
+  # '?' jsonb operators are ambiguous with the legacy API: write native $n
+  # parameters and use prepare_native for queries containing ?/?|/?& operators.
+  def self.rewrite_placeholders(sql, literals = [])
+    out = ""
+    i = 0
+    n = 0
+    quote = ""
+    dollar = ""
+    line_comment = false
+    depth = 0
+    escape_quote = false
+    while i < sql.length
+      c = sql[i, 1]
+      pair = sql[i, 2]
+      if line_comment
+        out += c
+        line_comment = false if c == "\n"
+      elsif depth > 0
+        if pair == "/*"
+          depth += 1
+          out += pair
+          i += 1
+        elsif pair == "*/"
+          depth -= 1
+          out += pair
+          i += 1
+        else
+          out += c
+        end
+      elsif dollar != ""
+        if sql[i, dollar.length] == dollar
+          out += dollar
+          i += dollar.length - 1
+          dollar = ""
+        else
+          out += c
+        end
+      elsif quote != ""
+        out += c
+        if escape_quote && c == "\\"
+          i += 1
+          out += sql[i, 1].to_s
+        elsif c == quote
+          if sql[i + 1, 1] == quote
+            out += quote
+            i += 1
+          else
+            quote = ""
+          end
+        end
+      elsif pair == "--"
+        line_comment = true
+        out += pair
+        i += 1
+      elsif pair == "/*"
+        depth = 1
+        out += pair
+        i += 1
+      elsif c == "'" || c == '"'
+        quote = c
+        prev = i > 0 ? sql[i - 1, 1] : ""
+        escape_quote = c == "'" && (prev == "E" || prev == "e")
+        out += c
+      elsif c == "$"
+        rest = sql[i, sql.length - i]
+        tag = rest.match(/\A\$(?:[A-Za-z_][A-Za-z_0-9]*)?\$/)
+        if !tag.nil?
+          dollar = tag[0]
+          out += dollar
+          i += dollar.length - 1
+        else
+          out += c
+        end
+      elsif c == "?"
+        n += 1
+        out += literals.empty? ? "$" + n.to_s : literals[n - 1].to_s
+      else
+        out += c
+      end
+      i += 1
+    end
+    out
+  end
+  def self.interpolate(sql, literals)
+    rewrite_placeholders(sql, literals)
+  end
+  def self.prepare(sql)
+    sql = ActiveRecord::Relation.inline_sql(sql)
+    prepare_native(rewrite_placeholders(sql))
+  end
+  def self.prepare_native(sql)
+    record_query(sql)
+    c = current_conn
+    name = c.next_name
+    r = PG.PQprepare(c.dbh, name, sql, 0, nil)
+    check_result(c, r)
+    PG.PQclear(r)
+    description = PG.PQdescribePrepared(c.dbh, name)
+    check_result(c, description)
+    PgStmt.new(c, name, description)
+  end
+  def self.step?(stmt)
+    stmt.advance
+  end
+  def self.finalize(stmt)
+    stmt.close
+  end
+  def self.bind_int(stmt, idx, value)
+    stmt.bind(idx, value.to_i.to_s)
+  end
+  def self.bind_text(stmt, idx, value)
+    raise "PostgreSQL text cannot contain NUL" if value.include?("\0")
+    stmt.bind(idx, value)
+  end
+  def self.bind_bool(stmt, idx, value)
+    stmt.bind(idx, value ? "true" : "false")
+  end
+  def self.bind_null(stmt, idx)
+    stmt.bind(idx, nil)
+  end
+  def self.prepare_uncached(sql)
+    prepare(sql)
+  end
+  def self.bind_int_opt(stmt, idx, value)
+    value.nil? ? bind_null(stmt, idx) : bind_int(stmt, idx, value)
+  end
+  def self.bind_text_opt(stmt, idx, value)
+    value.nil? ? bind_null(stmt, idx) : bind_text(stmt, idx, value)
+  end
+  def self.bind_bool_opt(stmt, idx, value)
+    value.nil? ? bind_null(stmt, idx) : bind_bool(stmt, idx, value)
+  end
+  def self.bind_float(stmt, idx, value)
+    stmt.bind(idx, value.to_f.to_s)
+  end
+  def self.column_null?(stmt, i)
+    PG.PQgetisnull(stmt.result, stmt.row, i) != 0
+  end
+  def self.column_text(stmt, i)
+    return "" if column_null?(stmt, i)
+    text = PG.PQgetvalue(stmt.result, stmt.row, i)
+    oid = PG.PQftype(stmt.result, i)
+    if oid == 1114 || oid == 1184
+      fraction = text.length > 19 && text[19, 1] == "." ? text[20, 6].to_s.split("+")[0].to_s : ""
+      text = text[0, 19] + "." + (fraction + "000000")[0, 6]
+    end
+    text
+  end
+  def self.column_int(stmt, i)
+    column_text(stmt, i).to_i
+  end
+  def self.column_float(stmt, i)
+    column_text(stmt, i).to_f
+  end
+  def self.column_bool(stmt, i)
+    s = column_text(stmt, i)
+    s == "t" || s == "true" || s == "1"
+  end
+  def self.column_int_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_int(stmt, i)
+  end
+  def self.column_float_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_float(stmt, i)
+  end
+  def self.column_text_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_text(stmt, i)
+  end
+  def self.column_bool_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_bool(stmt, i)
+  end
+  def self.column_value(stmt, i)
+    return nil if column_null?(stmt, i)
+    oid = PG.PQftype(stmt.result, i)
+    return column_bool(stmt, i) if oid == 16
+    return column_int(stmt, i) if oid == 20 || oid == 21 || oid == 23 || oid == 26
+    return column_float(stmt, i) if oid == 700 || oid == 701
+    return column_array(stmt, i) if oid == 1009
+    # NUMERIC (1700) stays a string to preserve decimal precision. Arrays,
+    # jsonb, uuid, timestamp, bytea text require schema-aware decoding above Db.
+    column_text(stmt, i)
+  end
+  def self.column_count(stmt)
+    PG.PQnfields(stmt.result)
+  end
+  def self.column_name(stmt, i)
+    PG.PQfname(stmt.result, i)
+  end
+  def self.changes
+    current_conn.changes
+  end
+  # Legacy integer-id compatibility only: session-local lastval(), unchanged
+  # by SELECT. Triggers can choose a different sequence; UUIDs have none.
+  # Lowered inserts use RETURNING; this is only the legacy facade fallback.
+  def self.last_insert_rowid
+    c = current_conn
+    r = PG.PQexec(c.dbh, "SELECT lastval()")
+    check_result(c, r)
+    n = PG.PQgetvalue(r, 0, 0).to_i
+    PG.PQclear(r)
+    n
+  end
+  def self.escape_string(s)
+    text = s.to_s
+    raise "PostgreSQL text cannot contain NUL" if text.include?("\0")
+    ptr = PG.PQescapeLiteral(current_conn.dbh, text, text.bytesize)
+    raise "PQescapeLiteral failed" if ptr.nil?
+    # :str duplicates foreign bytes into a GC string before freeing libpq's
+    # allocation. No process-global scratch buffer, including across threads.
+    quoted = PG.rh_pg_string(ptr)
+    PG.PQfreemem(ptr)
+    quoted
+  end
+  def self.escape_int(n)
+    n.to_i.to_s
+  end
+  def self.escape_bool(b)
+    b ? "TRUE" : "FALSE"
+  end
+  def self.escape_string_opt(s)
+    s.nil? ? "NULL" : escape_string(s)
+  end
+  def self.escape_int_opt(n)
+    n.nil? ? "NULL" : escape_int(n)
+  end
+  def self.escape_float_opt(f)
+    f.nil? ? "NULL" : f.to_f.to_s
+  end
+  def self.escape_bool_opt(b)
+    b.nil? ? "NULL" : escape_bool(b)
+  end
+  def self.escape_int_list(ids)
+    ids.empty? ? "NULL" : ids.map { |i| i.to_i.to_s }.join(", ")
+  end
+  # Explicit lifecycle lets framework yield directly, avoiding nested forwarding.
+  def self.transaction_begin
+    pool = pool_for_thread
+    idx = -1
+    if !in_lease?
+      idx = pool.lease
+      Thread.current[:db_conn] = pool.conn(idx)
+    end
+    outermost = PG.PQtransactionStatus(current_conn.dbh) == 0
+    exec("BEGIN") if outermost
+    PgTransaction.new(pool, idx, outermost)
+  end
+  def self.transaction_end(tx, commit)
+    begin
+      exec(commit ? "COMMIT" : "ROLLBACK") if tx.outermost
+    ensure
+      if tx.idx >= 0
+        conn = current_conn
+        if PG.PQtransactionStatus(conn.dbh) != 0
+          r = PG.PQexec(conn.dbh, "ROLLBACK")
+          PG.PQclear(r) if !r.nil?
+        end
+        Thread.current[:db_conn] = nil
+        tx.pool.release(tx.idx)
+      end
+    end
+    nil
+  end
+  def self.transaction
+    tx = transaction_begin
+    commit = false
+    begin
+      result = yield
+      commit = true
+    ensure
+      transaction_end(tx, commit)
+    end
+    result
+  end
+
+end
+
+module Db
+  def self.prepare_schema(path)
+    transaction do
+      exec("SELECT pg_advisory_xact_lock(7421930501)")
+      stmt = prepare("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = 'public' AND table_type = 'BASE TABLE'")
+      step?(stmt)
+      count = column_int(stmt, 0)
+      finalize(stmt)
+      if count == 0
+        exec(File.read(path))
+        exec("SET search_path = public")
+      end
+    end
+    nil
+  end
+  def self.insert_returning_int(sql)
+    stmt = prepare(sql)
+    begin
+      raise "INSERT returned no primary key" unless step?(stmt)
+      id = column_int(stmt, 0)
+    ensure
+      finalize(stmt)
+    end
+    id
+  end
+  def self.insert_returning_text(sql)
+    stmt = prepare(sql)
+    begin
+      raise "INSERT returned no primary key" unless step?(stmt)
+      id = column_text(stmt, 0)
+    ensure
+      finalize(stmt)
+    end
+    id
+  end
+  def self.prepare_locked(sql)
+    prepare(sql + " FOR UPDATE")
+  end
+  def self.column_array(stmt, i)
+    decode_array(column_text(stmt, i))
+  end
+  def self.column_array_opt(stmt, i)
+    column_null?(stmt, i) ? nil : column_array(stmt, i)
+  end
+  # One-dimensional, non-null text[]; quoted wire elements preserve NULL text.
+  def self.decode_array(text)
+    values = []
+    return values if text == "{}" || text == ""
+    value = ""
+    quoted = false
+    escaped = false
+    i = 1
+    while i < text.length - 1
+      c = text[i, 1]
+      if escaped
+        value += c
+        escaped = false
+      elsif c == "\\"
+        escaped = true
+      elsif c == '"'
+        quoted = !quoted
+      elsif c == "," && !quoted
+        values.push(value)
+        value = ""
+      else
+        value += c
+      end
+      i += 1
+    end
+    values.push(value)
+    values
+  end
+  def self.encode_array(values)
+    encoded = values.map do |v|
+      out = '"'
+      v.each_char do |c|
+        out += "\\" if c == "\\" || c == '"'
+        out += c
+      end
+      out + '"'
+    end
+    "{" + encoded.join(",") + "}"
+  end
+  def self.escape_array(values)
+    escape_string(encode_array(values)) + "::text[]"
+  end
+  def self.escape_array_opt(values)
+    values.nil? ? "NULL" : escape_array(values)
+  end
+
+end
+
+class PgTransaction
+  attr_reader :pool, :idx, :outermost
+  def initialize(pool, idx, outermost)
+    @pool = pool
+    @idx = idx
+    @outermost = outermost
+  end
+end
+
+module Db
+  def self.quote_identifier(name)
+    '"' + name.gsub('"', '""') + '"'
+  end
+end
+
+module Db
+  def self._txn_depth
+    d = Thread.current[:ar_txn_depth]
+    d.nil? ? 0 : d
+  end
+
+  def self._txn_depth=(value)
+    Thread.current[:ar_txn_depth] = value
+  end
+
+  # Bit `depth - 1` of this integer is whether that frame can be joined.
+  # Same thread slot as the depth. See runtime/ruby/db.rbs.
+  def self._txn_joinable_bits
+    bits = Thread.current[:ar_txn_joinable_bits]
+    bits.nil? ? 0 : bits
+  end
+
+  def self._txn_joinable_bits=(value)
+    Thread.current[:ar_txn_joinable_bits] = value
+  end
+
+  # The open transaction's enlisted writes (connection.rb), held in the
+  # same per-thread storage as the depth.
+  def self._txn_records
+    records = Thread.current[:ar_txn_records]
+    if records.nil?
+      records = [ActiveRecord::EnlistedRecord.new(ActiveRecord::Base.new, 0)]
+      records.clear
+      Thread.current[:ar_txn_records] = records
+    end
+    records
+  end
+
+  # The work `current_transaction.after_commit` holds for the COMMIT
+  # (ActiveRecord::Base._after_commit), beside the records above. Seeded
+  # and cleared, as the records are, so the element type is the work's.
+  def self._txn_callbacks
+    work = Thread.current[:ar_txn_callbacks]
+    if work.nil?
+      work = [-> { nil }]
+      work.clear
+      Thread.current[:ar_txn_callbacks] = work
+    end
+    work
+  end
+
+  # The tables whose model is inside `Model.unscoped { … }` on this
+  # thread (relation.rb's `Relation.unscoped_tables`). Seeded and
+  # cleared, as the records are, so the element type is String.
+  def self._unscoped_tables
+    tables = Thread.current[:ar_unscoped_tables]
+    if tables.nil?
+      tables = [""]
+      tables.clear
+      Thread.current[:ar_unscoped_tables] = tables
+    end
+    tables
+  end
+
+  def self.transaction_open?
+    PG.PQtransactionStatus(current_conn.dbh) != 0
+  end
+
+  def self.database_path
+    ENV.fetch("DATABASE_URL")
+  end
+
+  def self.adapter_name
+    "postgresql"
+  end
+end
