diff --git a/runtime/spinel/db_libpq.rb b/runtime/spinel/db_libpq.rb
new file mode 100644
index 000000000..465e9a4d6
--- /dev/null
+++ b/runtime/spinel/db_libpq.rb
@@ -0,0 +1,807 @@
+# frozen_string_literal: true
+
+# PostgreSQL implementation of Roundhouse's module Db contract.
+# Compile with Spinel 813def1f; links libpq directly. DATABASE_URL is conninfo.
+# Text wire format: arrays/jsonb/uuid stay strings; bool and numeric OIDs decode.
+# The only carried C helpers own a const char** parameter vector; they copy
+# strings because the Spinel FFI guarantees Ruby string lifetime for one call.
+require "json"
+require_relative "active_support_time_parsing"
+
+module PG
+  ffi_lib "pq"
+  ffi_const :CONNECTION_OK, 0
+  ffi_const :COMMAND_OK, 1
+  ffi_const :TUPLES_OK, 2
+  ffi_const :SQLSTATE, 67 # PG_DIAG_SQLSTATE = 'C'
+  ffi_func :PQconnectdb, [:str], :ptr, blocking: true
+  ffi_func :PQstatus, [:ptr], :int
+  ffi_func :PQerrorMessage, [:ptr], :str
+  ffi_func :PQfinish, [:ptr], :void
+  ffi_func :PQexec, [:ptr, :str], :ptr, blocking: true
+  ffi_func :PQprepare, [:ptr, :str, :str, :int, :ptr], :ptr, blocking: true
+  ffi_func :PQdescribePrepared, [:ptr, :str], :ptr, blocking: true
+  ffi_func :PQexecPrepared, [:ptr, :str, :int, :ptr, :ptr, :ptr, :int], :ptr, blocking: true
+  ffi_func :PQresultStatus, [:ptr], :int
+  ffi_func :PQresultErrorMessage, [:ptr], :str
+  ffi_func :PQresultErrorField, [:ptr, :int], :str
+  ffi_func :PQclear, [:ptr], :void
+  ffi_func :PQntuples, [:ptr], :int
+  ffi_func :PQnfields, [:ptr], :int
+  ffi_func :PQnparams, [:ptr], :int
+  ffi_func :PQfname, [:ptr, :int], :str
+  ffi_func :PQftype, [:ptr, :int], :uint32
+  ffi_func :PQgetisnull, [:ptr, :int, :int], :int
+  ffi_func :PQgetvalue, [:ptr, :int, :int], :str
+  ffi_func :PQcmdTuples, [:ptr], :str
+  ffi_func :PQtransactionStatus, [:ptr], :int
+  ffi_func :PQescapeLiteral, [:ptr, :str, :size_t], :ptr
+  ffi_func :PQfreemem, [:ptr], :void
+  ffi_source <<~C
+    #include <stdlib.h>
+    #include <string.h>
+    const char *rh_pg_string(void *p) { return (const char *)p; }
+    void *rh_pg_params_new(int n) { return calloc(n ? n : 1, sizeof(char *)); }
+    int rh_pg_params_set(void *p, int n, int i, const char *s) {
+      if (i < 1 || i > n) return -1;
+      char **v = (char **)p;
+      char *copy = s ? strdup(s) : NULL;
+      if (s && !copy) return -2;
+      free(v[i-1]); v[i-1] = copy; return 0;
+    }
+    void rh_pg_params_free(void *p, int n) {
+      if (!p) return;
+      char **v = (char **)p;
+      for (int i=0; i<n; i++) free(v[i]);
+      free(v);
+    }
+  C
+  ffi_func :rh_pg_string, [:ptr], :str
+  ffi_func :rh_pg_params_new, [:int], :ptr
+  ffi_func :rh_pg_params_set, [:ptr, :int, :int, :str], :int
+  ffi_func :rh_pg_params_free, [:ptr, :int], :void
+end
+
+class DbConn
+  def initialize(conninfo)
+    @dbh = PG.PQconnectdb(conninfo)
+    raise "PQconnectdb: allocation failed" if @dbh.nil?
+    if PG.PQstatus(@dbh) != PG::CONNECTION_OK
+      # Avoid including conninfo/password in errors.
+      message = PG.PQerrorMessage(@dbh)
+      PG.PQfinish(@dbh)
+      raise "PQconnectdb: " + message
+    end
+    @serial = 0
+    @changes = 0
+    @sqlstate = ""
+    r = PG.PQexec(@dbh, "SET standard_conforming_strings = on; SET timezone = 'UTC'; SET datestyle = 'ISO, YMD'; SET client_min_messages = warning")
+    Db.check_result(self, r)
+    PG.PQclear(r)
+  end
+  def dbh
+    @dbh
+  end
+  def next_name
+    @serial += 1
+    "rh_pg_" + @serial.to_s
+  end
+  def changes
+    @changes
+  end
+  def set_changes(n)
+    @changes = n
+  end
+  def sqlstate
+    @sqlstate
+  end
+  def set_sqlstate(s)
+    @sqlstate = s
+  end
+  def close
+    PG.PQfinish(@dbh)
+  end
+end
+
+# Owns both server prepared statement and PGresult cursor. Result metadata is
+# available immediately from PQdescribePrepared, before bind/step (select_rows
+# relies on this). Unlike SQLite, PGresult materializes all rows at first step.
+class PgStmt
+  def initialize(conn, name, description)
+    @conn = conn
+    @name = name
+    @result = description
+    @nparams = PG.PQnparams(description)
+    @params = PG.rh_pg_params_new(@nparams)
+    raise "parameter allocation failed" if @params.nil?
+    @row = -1
+    @executed = false
+    @closed = false
+  end
+  def conn
+    @conn
+  end
+  def result
+    @result
+  end
+  def row
+    @row
+  end
+  def bind(idx, text)
+    raise "bind after execution/finalize" if @executed || @closed
+    rc = PG.rh_pg_params_set(@params, @nparams, idx, text)
+    raise "invalid parameter index/allocation" if rc != 0
+    nil
+  end
+  def advance
+    raise "step after finalize" if @closed
+    if !@executed
+      r = PG.PQexecPrepared(@conn.dbh, @name, @nparams, @params, nil, nil, 0)
+      Db.check_result(@conn, r)
+      PG.PQclear(@result)
+      @result = r
+      @executed = true
+      @conn.set_changes(PG.PQcmdTuples(r).to_i)
+    end
+    @row += 1
+    @row < PG.PQntuples(@result)
+  end
+  def close
+    return nil if @closed
+    PG.PQclear(@result)
+    PG.rh_pg_params_free(@params, @nparams)
+    # DEALLOCATE errors during an aborted transaction must not mask the
+    # original error; rollback on lease release will recover the connection.
+    r = PG.PQexec(@conn.dbh, "DEALLOCATE " + @name)
+    PG.PQclear(r) if !r.nil?
+    @closed = true
+    nil
+  end
+end
+
+class DbPool
+  def initialize(conninfo, n)
+    @conns = []
+    @free = []
+    @lock = Mutex.new
+    @cv = ConditionVariable.new
+    i = 0
+    while i < n
+      @conns.push(DbConn.new(conninfo))
+      @free.push(i)
+      i += 1
+    end
+  end
+  def lease
+    idx = 0
+    @lock.synchronize do
+      @cv.wait(@lock) while @free.empty?
+      idx = @free.delete_at(@free.length - 1)
+    end
+    idx
+  end
+  def release(idx)
+    @lock.synchronize do
+      @free.push(idx)
+      @cv.signal
+    end
+    nil
+  end
+  def available
+    n = 0
+    @lock.synchronize { n = @free.length }
+    n
+  end
+  def conn(idx)
+    @conns[idx]
+  end
+  def first
+    @conns[0]
+  end
+  def close_all
+    @conns.each { |c| c.close }
+  end
+end
