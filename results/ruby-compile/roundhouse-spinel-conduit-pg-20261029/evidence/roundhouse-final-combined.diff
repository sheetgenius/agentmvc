+//! Rails surface regressions; the worker fixture additionally compiles and
+//! compares the same source against native Spinel and Rails.
+use std::collections::HashMap;
+use std::path::PathBuf;
+use roundhouse::{App, ingest::ingest_app_from_tree, emit::{ruby, EmittedFile}};
+
+fn app(model: &str, controller: &str) -> App {
+    let tree: HashMap<PathBuf, Vec<u8>> = [
+        ("db/schema.rb", r#"ActiveRecord::Schema.define do
+          create_table "users" do |t|; t.string "email"; t.string "username"; end
+          create_table "articles" do |t|; t.integer "author_id"; t.string "slug"; t.string "status"; end
+          create_table "comments" do |t|; t.integer "article_id"; end
+          create_table "follows", id: false do |t|
+            t.integer "follower_id"; t.integer "followed_id"
+            t.index ["follower_id", "followed_id"], unique: true
+          end
+        end"#),
+        ("app/models/user.rb", "class User < ApplicationRecord; end"),
+        ("app/models/comment.rb", "class Comment < ApplicationRecord; belongs_to :article; scope :active, -> { where(article_id: 1) }; end"),
+        ("app/models/article.rb", model),
+        ("app/models/follow.rb", "class Follow < ApplicationRecord; belongs_to :follower, class_name: 'User'; belongs_to :followed, class_name: 'User'; end"),
+        ("app/controllers/probes_controller.rb", controller),
+    ].into_iter().map(|(p,c)| (PathBuf::from(p), c.as_bytes().to_vec())).collect();
+    let mut app = ingest_app_from_tree(tree).unwrap();
+    roundhouse::session::analyze_and_lower(&mut app);
+    app
+}
+fn file(files: Vec<EmittedFile>, suffix: &str) -> String {
+    files.into_iter().find(|f| f.path.to_string_lossy().ends_with(suffix)).unwrap().content
+}
+#[test]
+fn singleton_ivar_initializers_are_eager_and_keep_source_order() {
+    let mut app = App::new();
+    app.library_classes = roundhouse::ingest::ingest_library_classes(
+        b"class Throttle; @lock = Mutex.new; @failures = Hash.new { |h,k| h[k] = [] }; @events = []; EVENTS = @events; @ready = @events.push(1); def self.fail!(key); @lock.synchronize { @failures[key].push(1) }; end; end", "throttle.rb").unwrap();
+    let src = file(ruby::emit_library(&app), "throttle.rb");
+    let positions: Vec<_> = ["@lock = Mutex.new", "@failures = Hash.new", "@events = []", "EVENTS = @events", "@ready = @events.push(1)"].iter().map(|s| src.find(s).unwrap()).collect();
+    assert!(positions.windows(2).all(|w| w[0] < w[1]), "{src}");
+}
+#[test]
+fn find_each_on_class_roots_on_relation() {
+    let app = app("class Article < ApplicationRecord; end", "class ProbesController < ApplicationController; def index; Article.find_each { |a| a.id }; end; end");
+    let src = file(ruby::emit_lowered_controllers(&app), "probes_controller.rb");
+    assert!(src.contains("ActiveRecord::Relation.new(Article).find_each"), "{src}");
+}
+#[test]
+fn association_scope_keeps_owner_predicate_for_pluck_and_update() {
+    let app = app("class Article < ApplicationRecord; has_many :comments; end", "class ProbesController < ApplicationController; def index; @article.comments.active.pluck(:id); @article.comments.active.update_all(article_id: 2); end; end");
+    let src = file(ruby::emit_lowered_controllers(&app), "probes_controller.rb");
+    assert!(src.contains("Comment.__scope_active__0(ActiveRecord::Relation.new(Comment).where(article_id: @article.id)"), "{src}");
+    assert!(src.contains(".pluck(:id)") && src.contains(".update_all("), "{src}");
+}
+#[test]
+fn left_joins_resolves_associations_and_projection_rows_are_retained() {
+    let app = app("class Article < ApplicationRecord; has_many :comments; end", "class ProbesController < ApplicationController; def index; Article.left_joins(:comments).select('articles.*, COUNT(comments.id) AS total').group('articles.id'); end; end");
+    let src=file(ruby::emit_lowered_controllers(&app), "probes_controller.rb");
+    assert!(src.contains("LEFT OUTER JOIN comments ON comments.article_id = articles.id"), "{src}");
+    let model=file(ruby::emit_lowered_models(&app), "article.rb");
+    assert!(model.contains("instance._note_projection(row)"), "{model}");
+    assert!(model.contains("_projection_attribute name.to_s"), "{model}");
+}
+
+#[test]
+fn array_to_set_demands_its_bundled_library_without_a_set_constant() {
+    let files = vec![("probe.rb".into(), "[1, 2, 2].to_set".into())];
+    let gaps = roundhouse::project::missing_bundled_requires(&files);
+    assert_eq!(gaps.len(), 1, "{gaps:?}");
+    assert!(gaps[0].contains("set"));
+    let files = vec![("probe.rb".into(), "require \"set\"\n[1,2].to_set".into())];
+    assert!(roundhouse::project::missing_bundled_requires(&files).is_empty());
+}
diff --git a/tests/spinel_raw_websocket.rb b/tests/spinel_raw_websocket.rb
new file mode 100644
index 000000000..f67fba381
--- /dev/null
+++ b/tests/spinel_raw_websocket.rb
@@ -0,0 +1,145 @@
+require "socket"
+require "io/wait"
+require "digest"
+require "base64"
+require "timeout"
+ROOT = File.expand_path(ARGV.fetch(0))
+
+# Test-only POSIX and DB bindings. All framing/lifecycle/facade code is real.
+module Sock
+  def self.sphttp_write_bytes(fd, bytes, n)
+    IO.for_fd(fd, autoclose: false).syswrite(bytes.byteslice(0, n))
+  end
+  def self.sp_net_recv_some(fd, n)
+    IO.for_fd(fd, autoclose: false).readpartial(n)
+  rescue EOFError
+    ""
+  end
+end
+module TepSocketControl
+  CALLS = []
+  def self.shutdown(fd, how)
+    CALLS << fd
+    socket = Socket.for_fd(fd)
+    socket.autoclose = false
+    socket.shutdown(how)
+    0
+  end
+end
+module Crypto
+  def self.sp_crypto_websocket_accept(key)
+    Base64.strict_encode64(Digest::SHA1.digest(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
+  end
+end
+module Db
+  LEASES = []
+  def self.with_connection
+    LEASES << Thread.current
+    yield
+  end
+end
+module Tep
+  def self.str_find(s, sub, offset); s.index(sub, offset) || -1; end
+  class Request
+    attr_accessor :verb, :req_headers
+    def initialize
+      @verb = ""
+      @req_headers = Hash.new("")
+    end
+  end
+  module Broadcast
+    CLOSED = []
+    def self.unsubscribe_fd(fd); CLOSED << fd; end
+  end
+  module Presence
+    CLOSED = []
+    def self.untrack_by_fd(fd); CLOSED << fd; end
+  end
+end
+require File.join(ROOT, "runtime/spinel/tep/websocket")
+require File.join(ROOT, "runtime/spinel/faye_websocket")
+
+def check(value, label)
+  raise label unless value
+end
+class Recorder < Tep::WebSocket::Handler
+  attr_reader :events
+  def initialize; @events = []; end
+  def handle_event(event); @events << event; end
+end
+
+# A close requested by another thread must wake a parked recv, send one
+# close, run one callback and refuse every subsequent write/shutdown.
+owner, peer = Socket.pair(:UNIX, :STREAM, 0)
+driver = Tep::WebSocket::Driver.new(owner.fileno)
+recorder = Recorder.new
+driver.set_on_close(recorder)
+connection = Tep::WebSocket::Connection.new(driver, owner)
+runner = Thread.new { connection.run }
+sleep 0.03
+driver.close(1000, "test")
+Timeout.timeout(1) { runner.join }
+check(recorder.events.size == 1, "close callback repeated/missing")
+check(peer.readpartial(100).getbyte(0) == 0x88, "missing close frame")
+check(driver.text("too late") == -1, "write after close")
+shutdowns = TepSocketControl::CALLS.size
+driver.close(1000, "again")
+check(TepSocketControl::CALLS.size == shutdowns, "shutdown after retirement")
+owner.close; peer.close
+
+# Open-time close must never enter wait_readable.
+class ClosingOpen < Tep::WebSocket::Handler
+  def initialize(driver); @driver = driver; end
+  def handle_event(event); @driver.close(1000, ""); end
+end
+class NoRead
+  def wait_readable(_); raise "recv after open-time close"; end
+end
+driver = Tep::WebSocket::Driver.new(-1)
+recorder = Recorder.new
+driver.set_on_open(ClosingOpen.new(driver))
+driver.set_on_close(recorder)
+Tep::WebSocket::Connection.new(driver, NoRead.new).run
+check(recorder.events.size == 1, "open-time close callback")
+
+# A received close ends the recv loop, rather than waiting for another frame.
+owner, peer = Socket.pair(:UNIX, :STREAM, 0)
+driver = Tep::WebSocket::Driver.new(owner.fileno)
+recorder = Recorder.new
+driver.set_on_close(recorder)
+runner = Thread.new { Tep::WebSocket::Connection.new(driver, owner).run }
+peer.write([0x88, 0x82, 0, 0, 0, 0, 3, 232].pack("C*"))
+Timeout.timeout(1) { runner.join }
+check(recorder.events.size == 1, "received close callback")
+owner.close; peer.close
+
+# Handler failures still retire and release the transport registries.
+class FailingOpen < Tep::WebSocket::Handler
+  def handle_event(_); raise "handler failed"; end
+end
+driver = Tep::WebSocket::Driver.new(-1)
+driver.set_on_open(FailingOpen.new)
+begin
+  Tep::WebSocket::Connection.new(driver, NoRead.new).run
+rescue RuntimeError => e
+  check(e.message == "handler failed", "wrong exception")
+end
+check(driver.text("late") == -1, "exception did not retire")
+check(Tep::Broadcast::CLOSED.last == -1 && Tep::Presence::CLOSED.last == -1, "exception did not clean up")
+
+# Faye-shaped callback closures, the request's upgrade marker and DB leases.
+env = {"REQUEST_METHOD" => "GET", "HTTP_UPGRADE" => "websocket",
+       "HTTP_CONNECTION" => "Upgrade", "HTTP_SEC_WEBSOCKET_VERSION" => "13",
+       "HTTP_SEC_WEBSOCKET_KEY" => "dGhlIHNhbXBsZSBub25jZQ=="}
+check(Faye::WebSocket.websocket?(env), "Faye handshake")
+check(!Faye::WebSocket.websocket?({}), "non-WebSocket accepted")
+socket = Faye::WebSocket.new(env, nil, ping: 0)
+messages = []
+socket.on(:message) { |event| messages << event.data }
+Tep::WebSocket::Connection.dispatch_message(socket.driver, "raw JSON", true)
+check(messages == ["raw JSON"] && !Db::LEASES.empty?, "callback/DB lease")
+check(socket.rack_response[0] == -1 && env["roundhouse.websocket"].equal?(socket), "upgrade marker")
+ran = false
+EventMachine.schedule { ran = true }
+check(ran, "schedule did not run")
+puts "ALL OK raw WebSocket lifecycle and Faye callbacks"
