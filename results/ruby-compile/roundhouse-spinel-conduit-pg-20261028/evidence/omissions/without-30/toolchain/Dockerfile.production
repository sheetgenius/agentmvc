# syntax=docker/dockerfile:1
# Compiled production image for the Conduit compile variant v11 (Roundhouse -> Spinel, PostgreSQL/libpq lane).
# Toolchain: roundhouse main 295abf08 + patches/series (9, without 30), Spinel master 3b397d7bc + 1 regression repair (93) (see SHA256SUMS).
ARG TOOLCHAIN_IMAGE=conduit-v11-toolchain:without-30
FROM ${TOOLCHAIN_IMAGE} AS toolchain
RUN echo '8f55b44a76669c5fa02879fb4e332cb41dd05199216d903435685d67cccb26d6  /usr/local/share/roundhouse-patches/SHA256SUMS' | sha256sum -c -
RUN echo 'e662cd99393088f7aa4aa7175340f71782872faa0f1afc77b2190ace880ddff4  /usr/local/share/spinel-patches/SHA256SUMS' | sha256sum -c -

FROM toolchain AS build
ENV RH_DATABASE_ADAPTER=postgresql CC=clang MAKEFLAGS=-j8
WORKDIR /src/app
COPY . .
RUN ulimit -v 12582912; /usr/bin/time -f "analysis peak_rss_kib=%M exit=%x" roundhouse check /src/app && /usr/bin/time -f "emission peak_rss_kib=%M exit=%x" roundhouse --target spinel -o /build /src/app
WORKDIR /build
RUN spin build -- --cc=clang --jobs=8 \
    && mkdir -p /runtime/static /runtime/public /runtime/db /runtime/config /runtime/storage \
    && set -- build/bin/* && test "$#" -eq 1 && test -x "$1" \
    && install -m755 "$1" /runtime/server && strip /runtime/server \
    && for dir in static public db config; do if [ -d "$dir" ]; then cp -a "$dir/." "/runtime/$dir/"; fi; done \
    && test -s /runtime/db/structure.sql && ldd /runtime/server

FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd AS runtime
RUN apt-get update -qq \
    && apt-get install --no-install-recommends -y libpq5 libjemalloc2 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home --home-dir /app app
WORKDIR /app
COPY --from=build --chown=10001:10001 /runtime/ ./
USER 10001:10001
# Deploy configuration, not a toolchain patch: OS workers per process for the declared 2-CPU budget,
# at the PostgreSQL lane's 2 workers per CPU (v4 derived the same 4 from the cgroup quota with a local
# Spinel patch). Spinel reads SPINEL_WORKERS at the first Thread.new and logs it in the boot banner.
ENV SPINEL_WORKERS=4
ENV PORT=8080
EXPOSE 8080
# Upstream now follows rails server's development localhost default.
# Match the frozen Rails image's explicit public binding without adding
# a fourth runtime environment variable to the production contract.
ENTRYPOINT ["/app/server", "--binding", "0.0.0.0"]
