+  # Fully drain through ReadyForQuery before handing the connection back.
+  # Retain the last PGresult, matching PQexec for multi-statement schema SQL.
+  def self.await_result(dbh, sent)
+    raise "libpq send: " + PG.PQerrorMessage(dbh) if sent != 1
+    result = nil
+    begin
+      flush = PG.PQflush(dbh)
+      while flush == 1
+        raise "libpq wait interrupted" if PG.rh_pg_wait(PG.PQsocket(dbh), 1) != 1
+        raise "libpq consume: " + PG.PQerrorMessage(dbh) if PG.PQconsumeInput(dbh) != 1
+        flush = PG.PQflush(dbh)
+      end
+      raise "libpq flush: " + PG.PQerrorMessage(dbh) if flush < 0
+      loop do
+        raise "libpq consume: " + PG.PQerrorMessage(dbh) if PG.PQconsumeInput(dbh) != 1
+        while PG.PQisBusy(dbh) == 1
+          raise "libpq wait interrupted" if PG.rh_pg_wait(PG.PQsocket(dbh), 0) != 1
+          raise "libpq consume: " + PG.PQerrorMessage(dbh) if PG.PQconsumeInput(dbh) != 1
+        end
+        next_result = PG.PQgetResult(dbh)
+        break if next_result.nil?
+        PG.PQclear(result) if !result.nil?
+        result = next_result
+      end
+    rescue
+      PG.PQclear(result) if !result.nil?
+      raise
+    end
+    result
+  end
