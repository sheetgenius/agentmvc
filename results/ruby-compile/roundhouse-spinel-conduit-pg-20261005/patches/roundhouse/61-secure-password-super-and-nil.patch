+
+#[test]
+fn supplied_nil_password_routes_through_writer() {
+    let app = app_with("class User < ApplicationRecord\n  has_secure_password\nend\n");
+    let files = roundhouse::emit::ruby::emit_lowered_models(&app);
+    let source = &files.iter().find(|f| f.path.to_string_lossy().ends_with("models/user.rb")).unwrap().content;
+    assert!((source.contains("self.password = attrs[:password] if attrs.key?(:password)") || source.contains("self.password = attrs[:password] if attrs.key? :password")), "{source}");
+    assert!(!source.contains("self.password = attrs[:password] if !(attrs[:password].nil?)"), "{source}");
+}
