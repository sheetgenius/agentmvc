+/// Install the selected backend before spin reshapes tests and writes requires.
+fn postgresql_files(mut files: Vec<(String, String)>, fixture: &Path) -> Result<Vec<(String, String)>, String> {
+    if !crate::postgresql_enabled() { return Ok(files); }
+    let ddl = std::fs::read_to_string(fixture.join("db/structure.sql"))
+        .map_err(|e| format!("PostgreSQL requires db/structure.sql: {e}"))?;
