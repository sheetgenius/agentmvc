--- /dev/null
+++ b/tests/integer_query_predicates.rs
@@ -0,0 +1,28 @@
+//! Rails integer query serialization must precede SQL execution.
+use std::{collections::HashMap, path::PathBuf, process::Command};
+use roundhouse::{emit::ruby, ingest::ingest_app_from_tree};
+
+#[test]
+fn integer_storage_widths_are_emitted_from_schema() {
+    let files = [
+        ("db/schema.rb", "ActiveRecord::Schema.define do\n create_table :widgets do |t|\n t.integer :number\n t.bigint :owner_id\n t.string :label\n end\nend\n"),
+        ("app/models/widget.rb", "class Widget < ApplicationRecord\nend\n"),
+    ];
+    let tree: HashMap<PathBuf, Vec<u8>> = files.into_iter().map(|(p, s)| (p.into(), s.as_bytes().to_vec())).collect();
+    let app = ingest_app_from_tree(tree).unwrap();
+    let model = &app.models[0];
+    let lowered = roundhouse::lower::model_to_library::lower_model_to_library_class(model, &app.schema);
+    let method = lowered.methods.iter().find(|m| m.name.as_str() == "schema_integer_limits").unwrap();
+    let source = ruby::emit_expr(&method.body);
+    assert!(source.contains("\"id\" => 8"), "{source}");
+    assert!(source.contains("\"number\" => 4"), "{source}");
+    assert!(source.contains("\"owner_id\" => 8"), "{source}");
+    assert!(source.contains("\"widgets.owner_id\" => 8"), "{source}");
+    assert!(!source.contains("label"), "{source}");
+}
+
+#[test]
+fn integer_query_runtime_matches_rails_boundaries_and_prefix_casts() {
+    let result = Command::new("ruby").arg("tests/integer_query_predicates.rb").output().expect("Ruby is available");
+    assert!(result.status.success(), "{}\n{}", String::from_utf8_lossy(&result.stdout), String::from_utf8_lossy(&result.stderr));
+}
