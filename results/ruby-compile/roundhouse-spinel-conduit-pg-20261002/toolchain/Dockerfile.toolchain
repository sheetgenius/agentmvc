# syntax=docker/dockerfile:1
# Toolchain for compile variant v5: Roundhouse main 5bbc4765 + patches/series (11), Spinel master d2c20df0b unpatched.
# Source exports are frozen by ../reproduce/prepare-toolchain.sh; see patches/SHA256SUMS. Spinel is built before
# Roundhouse so that a Roundhouse patch change does not rebuild Spinel.
FROM rust:1.90.0-trixie@sha256:e227f20ec42af3ea9a3c9c1dd1b2012aa15f12279b5e9d5fb890ca1c2bb5726c AS builder
ENV DEBIAN_FRONTEND=noninteractive CC=clang CARGO_BUILD_JOBS=8 MAKEFLAGS=-j8
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang make git pkg-config libsqlite3-dev sqlite3 libjemalloc-dev \
    libpq-dev postgresql-client curl ca-certificates libssl-dev libcrypt-dev \
    ruby file time && rm -rf /var/lib/apt/lists/*
COPY vendor/spinel /src/spinel
WORKDIR /src/spinel
RUN make deps -j8 && make -j8 CC=clang && make install -j8 CC=clang
COPY vendor/roundhouse /src/roundhouse
WORKDIR /src/roundhouse
RUN --mount=type=cache,id=v5-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=v5-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=v5-cargo-target,target=/src/roundhouse/target \
    ROUNDHOUSE_COMMIT=$(echo 5bbc4765ea05937f5760f4a64fbf1ff2b97c68f0 | cut -c1-8) cargo build --locked --release --bin roundhouse -j8 \
    && install -m755 target/release/roundhouse /usr/local/bin/roundhouse
RUN roundhouse --version && spinel --version && spin --version

FROM rust:1.90.0-trixie@sha256:e227f20ec42af3ea9a3c9c1dd1b2012aa15f12279b5e9d5fb890ca1c2bb5726c
ENV DEBIAN_FRONTEND=noninteractive CC=clang CARGO_BUILD_JOBS=8 MAKEFLAGS=-j8
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang make git pkg-config libsqlite3-dev sqlite3 libjemalloc-dev \
    libpq-dev postgresql-client curl ca-certificates libssl-dev libcrypt-dev \
    ruby file time && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/lib/spinel /usr/local/lib/spinel
COPY --from=builder /usr/local/bin/roundhouse /usr/local/bin/roundhouse
COPY patches /usr/local/share/roundhouse-patches
RUN ln -s /usr/local/lib/spinel/spinel /usr/local/bin/spinel \
    && ln -s /usr/local/lib/spinel/spin /usr/local/bin/spin
LABEL org.opencontainers.image.title="v5-toolchain" \
    roundhouse.commit="5bbc4765ea05937f5760f4a64fbf1ff2b97c68f0" \
    roundhouse.patches="/usr/local/share/roundhouse-patches/SHA256SUMS" \
    spinel.commit="d2c20df0bdc2c9c0788c24fff935c8a2fd6c5007"
WORKDIR /work
