+      raw = request.raw_post.to_s
+      value = JSON_MEDIA_TYPES.include?(media) && !raw.empty? ? JSON.parse(raw) : {}
+      @json_body = value.is_a?(Hash) ? value : {}
+      @json_media = JSON_MEDIA_TYPES.include?(media)
