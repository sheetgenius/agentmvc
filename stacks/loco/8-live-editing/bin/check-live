#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
port="${1:?usage: bin/check-live PORT}"
docker run --rm --network host \
  -v "$PWD/realworld_spec:/spec:ro" \
  mcr.microsoft.com/playwright:v1.63.0-noble \
  sh -euc '
    mkdir -p /tmp/spec
    (cd /spec && tar --exclude="./frontend/node_modules" --exclude="./frontend/test-results" -cf - .) | tar -C /tmp/spec -xf -
    /tmp/spec/features/live-editing/bin/check "$1"
  ' sh "$port"
