#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
python manage.py migrate --noinput
python manage.py procrastinate worker &
worker_pid=$!
uvicorn config.asgi:application --host 0.0.0.0 --port "${PORT:-4111}" --lifespan off "$@" &
web_pid=$!
stop() {
  kill "$worker_pid" "$web_pid" 2>/dev/null || true
  wait "$worker_pid" "$web_pid" 2>/dev/null || true
}
trap stop EXIT
trap 'exit 0' TERM INT
wait -n "$worker_pid" "$web_pid"
exit 1
