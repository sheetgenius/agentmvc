#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
export DJANGO_DEBUG=1
python manage.py migrate --noinput
watchfiles --filter python 'python manage.py procrastinate worker' . &
worker=$!
uvicorn config.asgi:application --host 0.0.0.0 --port "${PORT:-4111}" --lifespan off --reload &
server=$!
trap 'kill "$worker" "$server" 2>/dev/null || true; wait || true' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
wait -n "$worker" "$server"
