#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
python manage.py migrate --noinput
python manage.py procrastinate worker &
worker=$!
uvicorn config.asgi:application --host 0.0.0.0 --port "${PORT:-4111}" --lifespan off &
server=$!
trap 'kill "$worker" "$server" 2>/dev/null || true; wait || true' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
wait -n "$worker" "$server"
