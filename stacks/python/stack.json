{
  "name": "Django + Django Ninja",
  "stack": "python",
  "language": "Python",
  "description": "CPython 3.14.7, Django 6.1.1, Django Ninja 1.7.1, PostgreSQL 17, Channels, Procrastinate",
  "port": 4111,
  "toolchain_image": "agentmvc-python-toolchain:preflight",
  "code": {
    "extensions": {".py": "#", ".sql": "--", ".sh": "#"},
