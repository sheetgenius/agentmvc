#!/usr/bin/env bash
set -euo pipefail

port="${1:?usage: bin/check-live PORT}"
harness="$PWD/tmp/live-harness"
mkdir -p "$harness"
rsync -a --exclude node_modules --exclude test-results realworld_spec/ "$harness/"
docker run --rm --network host \
  -v "$harness:/spec" \
  -w /spec mcr.microsoft.com/playwright:v1.63.0-noble \
  /spec/features/live-editing/bin/check "$port"
