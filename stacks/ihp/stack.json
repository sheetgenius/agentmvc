      "build/Generated"
    ],
    "skip_dirs": [
      "build",
      "security",
      "harness",
      ".devenv",
      ".cache",
      ".tmp",
      "Test",
      ".github"
    ],
    "skip_paths": [
      "Config/nix"
    ]
  },
  "security": {
    "lockfile": "flake.lock",
    "analyzer": null
  },
  "setup": "harness/ihp.sh build"
}
